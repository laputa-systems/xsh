}

type CandidateCpuCache = {
  id: Int,
  owner_cpu_id: Int,
  sysfs_index: Int,
  level: Int,
  kind: Str,
  size_bytes: Int?,
  line_size_bytes: Int?,
  sets: Int?,
  shared_cpus: List[Int],
}

type CandidateCpuCacheMembership = {id: Int, cache_ids: List[Int]}

