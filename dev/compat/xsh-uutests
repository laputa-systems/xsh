#!/bin/sh
# uutils multicall contract for XSH: `xsh-uutests <utility> <args...>`.
#
# The uutils integration suite runs `$UUTESTS_BINARY_PATH <utility> <args...>`
# for every command under test. This dispatcher execs the staged XSH applet for
# <utility> with argv, stdio, cwd, environment and signals untouched; it is a
# dispatcher, not a second implementation, so it never rewrites arguments.
#
# The suite itself runs the XSH adapter staged by stage.py (generated from
# xsh-uutests.xsh), which has no shell and so starts under a tiny
# RLIMIT_NOFILE where this script cannot. This script is the manual shell
# equivalent: point XSH_COMPAT_STAGE at a staged directory. A utility with no
# staged applet exits 127 with a diagnostic, so a missing command is a visible
# failure rather than a fall-through to a host binary.
stage=${XSH_COMPAT_STAGE:-$(cd "$(dirname "$0")" && pwd)}
if [ ! -d "$stage/bin" ]; then
	echo "xsh-uutests: no stage at $stage; run dev/compat/stage.py and set XSH_COMPAT_STAGE" >&2
	exit 2
fi

if [ "$#" -eq 0 ]; then
	echo "usage: xsh-uutests UTILITY [ARG...]" >&2
	exit 2
fi
util=$1
shift

case $util in
	*/* | "" | . | ..)
		echo "xsh-uutests: invalid utility name '$util'" >&2
		exit 2
		;;
esac

applet=$stage/bin/$util
if [ ! -x "$applet" ] || [ -d "$applet" ]; then
	echo "xsh-uutests: XSH provides no applet for '$util'" >&2
	exit 127
fi

# A runaway applet must fail its own test rather than exhaust the host: the
# address-space cap is read from the stage (written by stage.py from
# XSH_COMPAT_MEM_KB, default 3 GiB; "unlimited" disables it).
limit=$(cat "$stage/mem-limit-kb" 2>/dev/null || echo 3145728)
[ "$limit" = unlimited ] || ulimit -v "$limit" 2>/dev/null || true

# uutils' usage_error helper expects the multicall hint `Try '<binary> <util>
# --help'`; applets print `Try 'PHRASE --help'` with PHRASE taken from this
# variable (see CAMPAIGN.md, Decisions). The adapter only sets it; it never
# rewrites argv or output.
XSH_EXECUTION_PHRASE="$0 $util"
export XSH_EXECUTION_PHRASE

exec "$applet" "$@"
