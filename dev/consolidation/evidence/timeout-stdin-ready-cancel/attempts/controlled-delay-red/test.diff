+  child.write("let marker = Path(args[0])\nlet ready = Path(args[1])\nlet blocked = Path(args[2])\ndefer marker.write(\"cleaned\")?\nready.write(\"ready\")?\nlet first = io.stdin_read(1)?\nassert first == b\"x\"\nblocked.write(\"blocked\")?\nlet _ = io.stdin_bytes()?\n")
   let plan = process.command_argv(
     p"/bin/sh",
     [
       "sh",
       "-c",
-      "(printf x; while [ ! -e \"$4\" ]; do sleep 0.01; done) | \"$1\" \"$2\" .05 \"$1\" \"$3\" \"$4\"",
+      "(printf x; sleep 0.4) | \"$1\" \"$2\" .05 /bin/sh -c 'sleep 0.15; exec \"$1\" \"$2\" \"$3\" \"$4\" \"$5\"' delayed-child \"$1\" \"$3\" \"$4\" \"$5\" \"$6\"",
       "timeout-stdin-probe",
       ctx.xsh_bin,
       fp"{ctx.core_dir}/timeout.xsh",
       child,
       marker,
+      ready,
+      blocked,
     ],
     root,
     {},
@@ -120,8 +124,27 @@ test timeout_stops_an_xsh_child_blocked_in_stdin_read { |ctx|
     fp"{root}/stderr",
     timeout: 2s,
   )
-  let status = process.run(plan)?.shell_code()?
-  assert status == 124
+  let started = time.now()
+  let output = process.run(plan)
+  let elapsed = time.now() - started
+  let stderr = fp"{root}/stderr".read_text()?
+  let stdout = fp"{root}/stdout".read_text()?
+  let child_ready = ready.exists()?
+  let child_blocked = blocked.exists()?
+  let cleaned = marker.exists()?
