diff --git a/core/tests/test-timeout.xsh b/core/tests/test-timeout.xsh
index 702055ebc..72e60e1b0 100644
--- a/core/tests/test-timeout.xsh
+++ b/core/tests/test-timeout.xsh
@@ -99,19 +99,23 @@ test timeout_stops_a_cpu_bound_xsh_child_and_runs_its_cleanup { |ctx|
 test timeout_stops_an_xsh_child_blocked_in_stdin_read { |ctx|
   let root = test.temp_dir(ctx, name: "timeout-xsh-stdin")?
   let marker = fp"{root}/cleanup"
+  let ready = fp"{root}/ready"
+  let blocked = fp"{root}/blocked"
   let child = fp"{root}/child.xsh"
