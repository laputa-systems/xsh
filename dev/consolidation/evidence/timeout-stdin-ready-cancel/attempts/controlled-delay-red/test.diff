+    Ok(finished) => finished.shell_code()?
+    Err(failure) => {
+      let detail = f"outer run error={failure.message}; status=unavailable; elapsed={elapsed}; ready={child_ready}; blocked={child_blocked}; cleanup={cleaned}; stdout={stdout}; stderr={stderr}"
+      print f"timeout_stdin_observation {detail}"
+      assert false, detail
+      return
+    }
+  }
+  print f"timeout_stdin_observation status={status}; elapsed={elapsed}; ready={child_ready}; blocked={child_blocked}; cleanup={cleaned}; stdout={stdout}; stderr={stderr}"
+  assert status == 124, f"status={status}; ready={child_ready}; blocked={child_blocked}; cleanup={cleaned}; stderr={stderr}"
+  assert ready.read_text()? == "ready"
+  assert blocked.read_text()? == "blocked"
   assert marker.read_text()? == "cleaned"
 }
