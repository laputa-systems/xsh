+            panic!("source must start with a binding expression");
+        };
+        assert!(matches!(
+            program.arena.expr(expression).kind,
+            ArenaExprKind::ValueBlock(_)
+        ));
+        let span = program.arena.expr(expression).span;
+        let checked = program
+            .symbol_owner()
+            .with_current(|| Checker::check_arena(&program, source));
+        assert!(
+            checked
+                .diagnostics
+                .iter()
+                .all(|diagnostic| diagnostic.code == Some(DiagnosticCode::CheckLoopNoBreak)),
+            "{:?}",
+            checked.diagnostics
+        );
+        checked
+            .expr_types
+            .get(&span)
+            .cloned()
+            .expect("value block should have a checked type")
+    }
+
+    #[test]
+    fn captured_failure_value_block_completes_with_result_error() {
+        assert_eq!(
+            value_block_type(
+                "let result: Result[Unit] = { try { loop { assert false } } }\n"
+            ),
+            Type::Result(Box::new(Type::Unit), Box::new(Type::Error))
+        );
+    }
+
+    #[test]
+    fn within_timeout_value_block_completes_with_result_error() {
+        assert_eq!(
+            value_block_type(
+                "let result: Result[Unit] = { within 50ms { loop {} } }\n"
+            ),
+            Type::Result(Box::new(Type::Unknown), Box::new(Type::Error))
+        );
+    }
+
+    #[test]
+    fn unit_position_scope_without_success_prevents_a_later_value() {
+        assert_eq!(
+            value_block_type(
+                "let result: Result[Unit] = {\n  within 50ms { loop {} }\n  Ok()\n}\n"
+            ),
+            Type::Unknown
+        );
+    }
+
+    #[test]
+    fn wait_until_with_a_false_condition_has_no_inferred_success_value() {
+        let source = "let late = try {\n  wait until false within 50ms backoff 10ms..20ms\n}\n";
+        let parsed = Parser::parse_source_arena_only(SourceId::new(0), source);
+        assert!(parsed.diagnostics.is_empty(), "{:?}", parsed.diagnostics);
+        let program = parsed.arena;
+        let diagnostics = program
+            .symbol_owner()
+            .with_current(|| Checker::check_arena(&program, source).diagnostics);
+
+        assert!(
+            diagnostics
+                .iter()
+                .any(|diagnostic| diagnostic.code == Some(DiagnosticCode::CheckTrySuccessType)),
+            "{diagnostics:?}"
+        );
+    }
+
+    #[test]
+    fn loop_completion_uses_only_reachable_breaks_for_its_own_loop() {
+        assert!(proc_never_completes(
+            "proc spin() [] { loop { if false { break } } }"
+        ));
+        assert!(!proc_never_completes(
+            "proc exits() [] { while true { break } }"
+        ));
+        assert!(!proc_never_completes(
+            "proc known_true() [] { loop { if true { break } } }"
+        ));
+        assert!(proc_never_completes(
+            "proc nested() [] { loop { loop { break } } }"
+        ));
+        assert!(!proc_never_completes(
+            "proc nested_exit() [] { loop { loop { break }; break } }"
+        ));
+        assert!(proc_never_completes(
+            "proc dead_break() [] { loop { return; break } }"
+        ));
+        assert!(proc_never_completes(
+            "proc dead_continue() [] { loop { continue; break } }"
+        ));
+        assert!(proc_never_completes(
+            "proc dead_exit() [] { loop { exit 0; break } }"
+        ));
+        assert!(!proc_never_completes(
+            "proc unexhaustive_match() [] { loop { match true { true => { return } }; break } }"
+        ));
+    }
+
+    #[test]
+    fn try_retry_and_context_scopes_keep_enclosing_loop_breaks() {
+        assert!(!proc_never_completes(
+            "proc tried() [] { loop { try { break } } }"
+        ));
+        assert!(!proc_never_completes(
+            "proc retried() [] { loop { retry [] { break } } }"
+        ));
+        assert!(!proc_never_completes(
+            "proc scoped() [] { loop { within 1s { break } } }"
+        ));
+    }
+
+    #[test]
+    fn captured_returns_make_the_enclosing_loop_non_fallthrough() {
+        let source = "proc value() [] -> Int { loop { try { return 1 }; break } }";
+        assert!(proc_never_completes(source));
+        let program = parse(source);
+        let diagnostics = program
+            .symbol_owner()
+            .with_current(|| Checker::check_arena(&program, source).diagnostics);
+
+        assert!(
+            diagnostics
+                .iter()
+                .all(|diagnostic| diagnostic.code != Some(DiagnosticCode::CheckMissingReturn)),
+            "{diagnostics:?}"
+        );
+    }
+
+    #[test]
+    fn captured_error_before_return_keeps_the_enclosing_loop_break_reachable() {
+        assert!(!proc_never_completes(
+            "proc value() [] { loop { try { assert false; return 1 }; break } }"
+        ));
+    }
+
+    #[test]
+    fn glob_failure_before_return_keeps_capture_result_value() {
+        let source = "proc f() [fs] -> List[Path] {\n  let ignored: Result[Unit] = { try { return g\"\\0\" } }\n  []\n}\n";
+        let program = parse(source);
+        let binding = program
+            .arena
+            .stmt_ids(program.arena.block(first_proc_body(&program)).statements)
+            .find(|id| matches!(program.arena.stmt(*id).kind, ArenaStmtKind::Let { .. }))
+            .expect("procedure body should declare ignored");
+        let ArenaStmtKind::Let {
+            initializer: ArenaExprOrRun::Expr(expression),
+            ..
+        } = program.arena.stmt(binding).kind
+        else {
+            panic!("ignored initializer should be an expression");
+        };
+        let span = program.arena.expr(expression).span;
+        let checked = program
+            .symbol_owner()
+            .with_current(|| Checker::check_arena(&program, source));
+
+        assert!(checked.diagnostics.is_empty(), "{:?}", checked.diagnostics);
+        assert_eq!(
+            checked.expr_types.get(&span),
+            Some(&Type::Result(Box::new(Type::Unit), Box::new(Type::Error)))
+        );
+    }
+
+    #[test]
+    fn evaluated_assignment_and_builder_values_keep_enclosing_loop_breaks() {
+        assert!(!proc_never_completes(
+            "proc indexed() [] { loop { items[try { break }] = 0 } }"
+        ));
+        assert!(!proc_never_completes(
+            "proc builder() [] { loop { let _plan = process.command { timeout = try { break }; run true } } }"
+        ));
+    }
+
+    #[test]
+    fn deferred_break_does_not_complete_the_enclosing_loop() {
+        assert!(proc_never_completes(
+            "proc deferred() [] { loop { defer { break } } }"
+        ));
+        assert!(proc_never_completes(
+            "proc callback() [] { loop { [1] |> map { break } } }"
+        ));
+        assert!(proc_never_completes(
+            "proc nested_callable() [] { loop { proc nested() [] { break } } }"
+        ));
+        assert!(proc_never_completes(
+            "proc builder_task() [] { loop { let _plan = process.command { task child { break } } } }"
+        ));
+    }
+}
