+fn block_guarantees_escaping_control_arena(arena: &ArenaProgram, block: BlockId) -> bool {
+    let mut statements = arena
+        .arena
+        .stmt_ids(arena.arena.block(block).statements);
+    let Some(statement) = statements.next() else {
+        return false;
+    };
+    if statements.next().is_some() {
+        return false;
+    }
+    stmt_guarantees_escaping_control_arena(arena, arena.arena.core_stmt_id(statement))
+}
+
+fn stmt_guarantees_escaping_control_arena(arena: &ArenaProgram, statement: StmtId) -> bool {
+    match arena.arena.stmt(statement).kind {
+        ArenaStmtKind::Sugar { expansion, .. } => {
+            stmt_guarantees_escaping_control_arena(arena, expansion)
+        }
+        ArenaStmtKind::Return(value) => value
+            .is_none_or(|value| matches!(value, ArenaExprOrRun::Expr(expr) if control_operand_is_infallible_literal_arena(arena, expr))),
+        ArenaStmtKind::Break { value } => value
+            .is_none_or(|expr| control_operand_is_infallible_literal_arena(arena, expr)),
+        ArenaStmtKind::Continue => true,
+        ArenaStmtKind::Exit(status) => control_operand_is_infallible_literal_arena(arena, status),
+        _ => false,
+    }
+}
+
+fn control_operand_is_infallible_literal_arena(arena: &ArenaProgram, expression: ExprId) -> bool {
+    matches!(
+        arena.arena.expr(expression).kind,
+        ArenaExprKind::Null
+            | ArenaExprKind::Bool(_)
+            | ArenaExprKind::Int(_)
+            | ArenaExprKind::Float(_)
+            | ArenaExprKind::Duration(_)
+            | ArenaExprKind::Str(_)
+            | ArenaExprKind::Bytes(_)
+            | ArenaExprKind::Regex(_)
+    )
+}
+
+fn block_has_reachable_break_target_arena(arena: &ArenaProgram, block: BlockId) -> bool {
+    for id in arena.arena.stmt_ids(arena.arena.block(block).statements) {
+        if stmt_has_reachable_break_target_arena(arena, id) {
+            return true;
+        }
+        if stmt_never_falls_through_arena(arena, id) {
+            return false;
+        }
+    }
+    false
+}
+
+fn stmt_never_falls_through_arena(arena: &ArenaProgram, id: StmtId) -> bool {
+    match arena.arena.stmt(id).kind {
+        ArenaStmtKind::Match { .. } => false,
+        ArenaStmtKind::Sugar { expansion, .. } => stmt_never_falls_through_arena(arena, expansion),
+        ArenaStmtKind::If {
+            branches,
+            else_block,
+        } => {
+            for branch in arena.arena.if_branches(branches) {
+                let condition = arena.arena.expr(branch.condition).kind;
+                if matches!(condition, ArenaExprKind::Bool(false)) {
+                    continue;
+                }
+                if !block_never_falls_through_arena(arena, branch.block) {
+                    return false;
+                }
+                if matches!(condition, ArenaExprKind::Bool(true)) {
+                    return true;
+                }
+            }
+            else_block.is_some_and(|block| block_never_falls_through_arena(arena, block))
+        }
+        ArenaStmtKind::With { body, else_block, .. } => {
+            block_never_falls_through_arena(arena, body)
+                && block_never_falls_through_arena(arena, else_block)
+        }
+        _ => stmt_always_returns_arena(arena, id),
+    }
+}
+
+fn stmt_has_reachable_break_target_arena(arena: &ArenaProgram, id: StmtId) -> bool {
+    match arena.arena.stmt(id).kind {
+        ArenaStmtKind::Break { .. } => true,
+        ArenaStmtKind::Loop { .. }
+        | ArenaStmtKind::Defer(..)
