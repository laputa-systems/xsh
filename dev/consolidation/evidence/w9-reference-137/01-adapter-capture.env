HOME=/home/josh
PATH=/usr/bin:/bin
TMPDIR=/home/josh/d/laputa-systems/xsh/.work/tmp
PYTHONDONTWRITEBYTECODE=1
LC_ALL=C
TZ=UTC
DOCKER_HOST=unset at launch; runner validates default local context then pins unix:///var/run/docker.sock
DOCKER_CONTEXT=unset at launch; runner requires default local context
capture slots=A:cpu0,B:cpu1,C:cpu2,D:cpu3
memory per slot=1GiB
memory swap per slot=1GiB total memory-swap cap, leaving no swap headroom
network=none
exact_owner_proofs=strict compare validates and retains fresh reference and candidate proofs
