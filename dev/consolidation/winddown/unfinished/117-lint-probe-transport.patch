+        if let ArenaStmtKind::ProcDef(def) | ArenaStmtKind::StreamDef(def) | ArenaStmtKind::CliMain(def) = kind {
+            bodies.push(program.arena.span(program.arena.block(program.arena.function_def(def).body).span));
+        }
+    }
+    Some((source_id?, bodies))
+}
+
+pub(crate) fn check_probe_candidate(
+    context: &super::ReturnProofContext,
+    source: &str,
+) -> Option<CheckedProbeSnapshot> {
+    let workspace = xsh::frontend::load::parse_load_entries_shared_arena_only(vec![
+        xsh::frontend::load::ArenaEntryInput {
+            file: context.file.clone(),
+            bytes: source.as_bytes().to_vec(),
+            module_roots: context.module_roots.clone(),
+        },
+    ]);
+    if workspace.entries.len() != 1 {
+        return None;
+    }
+    let mut entries = workspace.entries.into_iter();
+    let entry = entries.next()?;
+    let source_id = entry.source_id;
+    if entry.file != context.file {
+        return None;
+    }
+    let source_name = if context.file.contains(std::path::MAIN_SEPARATOR) {
+        std::path::absolute(&context.file)
+            .ok()
+            .and_then(|path| path.to_str().map(str::to_owned))
+            .unwrap_or_else(|| context.file.clone())
+    } else {
+        context.file.clone()
+    };
+    let source_file = workspace.sources.get(source_id)?;
+    if source_file.id() != source_id
+        || source_file.name() != source_name
+        || source_file.text().as_bytes() != source.as_bytes()
+    {
+        return None;
+    }
+    let (entry_source_id, effect_body_spans) = checked_source_effect_bodies(
+        &workspace.program,
+        workspace.program.arena.stmt_ids(entry.statements),
+        source,
+    )?;
+    if entry_source_id != source_id {
+        return None;
+    }
+    let diagnostics = entry.diagnostics;
+    let checked = if diagnostics.is_empty() {
+        let session = xsh::frontend::check::CheckSession::new(
+            std::sync::Arc::clone(&workspace.program),
+            std::sync::Arc::clone(&workspace.sources),
+        );
+        Some(session.check(
+            entry.statements,
+            source_id,
+            xsh::frontend::check::CheckOptions::default(),
+        ))
+    } else {
+        None
+    };
+    Some(CheckedProbeSnapshot {
+        program: workspace.program,
+        sources: workspace.sources,
+        source_id,
+        effect_body_spans,
+        diagnostics,
+        checked,
+    })
+}
+
+pub(super) fn checked_local_annotation_facts_from_output(
+    checked: &xsh::frontend::check::CheckOutput,
+    source_id: xsh::frontend::source::SourceId,
+) -> Option<CheckedLocalAnnotationFacts> {
+    if checked.diagnostics.iter().any(|diagnostic| {
+        diagnostic.severity == Severity::Error
+    }) {
+        return None;
+    }
+    let owner = xsh::frontend::symbols::SymbolOwner::current()?;
+    owner.with_current(|| {
+        let mut bindings = BTreeMap::new();
+        for (span, ty) in &checked.local_binding_types {
+            if span.source_id == source_id {
+                bindings
+                    .entry(span.start())
+                    .or_insert_with(|| checked_return_type_shape(ty));
+            }
+        }
+        let expressions = checked
+            .expr_types
+            .iter()
+            .filter(|(span, _)| span.source_id == source_id)
+            .map(|(span, ty)| {
+                (
+                    (span.start(), span.end()),
+                    checked_return_type_shape(ty),
+                )
+            })
+            .collect();
+        Some(CheckedLocalAnnotationFacts {
+            bindings,
+            expressions,
+        })
+    })
+}
+
+fn source_facts<'a, T: 'a, R>(
+    facts: impl Iterator<Item = (&'a Span, &'a T)>,
+    source_id: xsh::frontend::source::SourceId,
+    removed: &[(usize, usize)],
+    mut project: impl FnMut(&T) -> R,
+) -> Vec<(usize, usize, R)> {
+    facts
+        .filter(|(span, _)| span.source_id == source_id)
+        .map(|(span, fact)| (
+            original_offset(span.start(), removed),
+            original_offset(span.end(), removed),
+            project(fact),
+        ))
+        .collect()
+}
+
+fn original_offset(offset: usize, removed: &[(usize, usize)]) -> usize {
+    removed.iter().fold(offset, |offset, &(start, length)| {
+        if offset >= start { offset + length } else { offset }
+    })
+}
+
+pub(super) fn checked_return_removal_facts_from_output(
+    checked: &xsh::frontend::check::CheckOutput,
+    source_id: xsh::frontend::source::SourceId,
+    expected_effect_bodies: &[Span],
+    removed: &[(usize, usize)],
+    source_diagnostics_forbidden: bool,
+) -> Option<CheckedReturnRemovalFacts> {
+    if checked.diagnostics.iter().any(|diagnostic| {
+        diagnostic.severity == Severity::Error
+            || (source_diagnostics_forbidden && diagnostic_mentions_source(diagnostic, source_id))
+    }) {
+        return None;
+    }
+    let source_effect_count = checked.function_effect_facts.keys()
+        .filter(|id| id.body.source_id == source_id).count();
+    if source_effect_count != expected_effect_bodies.len()
+        || expected_effect_bodies.iter().any(|body| !checked.function_effect_facts.keys().any(|id| id.body == *body)) {
+        return None;
+    }
+    let owner = xsh::frontend::symbols::SymbolOwner::current()?;
+    owner.with_current(|| {
+        Some(CheckedReturnRemovalFacts {
+            expressions: source_facts(checked.expr_types.iter(), source_id, removed, checked_return_type_shape),
+            statements: source_facts(checked.statement_positions.iter(), source_id, removed, |position| *position),
+            returns: source_facts(checked.function_return_types.iter(), source_id, removed, checked_return_type_shape),
+            parameters: source_facts(checked.parameter_types.iter(), source_id, removed, checked_return_type_shape),
+            effects: checked
+                .function_effect_facts
+                .iter()
+                .filter(|(id, _)| id.body.source_id == source_id)
+                .map(|(id, fact)| {
+                    let normalize = |effects: &Option<Vec<Effect>>| {
+                        effects.as_ref().map(|effects| {
+                            let mut effects = effects.clone();
+                            effects.sort_by_key(Effect::as_str);
+                            effects.dedup();
+                            effects
+                        })
+                    };
+                    (
+                        (
+                            original_offset(id.body.start(), removed),
+                            original_offset(id.body.end(), removed),
+                        ),
+                        CheckedEffectContractFact {
+                            effective: normalize(&fact.effective),
+                            required: normalize(&fact.required),
+                            unknown_chain: fact.unknown_chain.clone(),
+                        },
+                    )
+                })
+                .collect(),
+        })
+    })
+}
+
+fn diagnostic_mentions_source(
+    diagnostic: &xsh::diagnostic::Diagnostic,
+    source_id: xsh::frontend::source::SourceId,
+) -> bool {
+    diagnostic
+        .span
+        .into_iter()
+        .chain(diagnostic.labels.iter().map(|label| label.span))
+        .chain(diagnostic.fix_hints.iter().filter_map(|hint| hint.span))
+        .any(|span| span.source_id == source_id)
+}
+
+#[cfg(test)]
+mod effect_fact_completeness_tests {
+    use super::{checked_source_effect_bodies, checked_return_removal_facts_from_output};
+    use xsh::frontend::{
+        check::Checker,
+        source::SourceId,
+        syntax::parser::Parser,
+    };
+
+    #[test]
+    fn missing_source_effect_fact_refuses_a_proof_snapshot() {
+        let source = "proc local() [io] -> Str { print \"local\"; \"local\" }\n";
+        let source_id = SourceId::new(0);
+        let parsed = Parser::parse_source_arena_only(source_id, source);
+        assert!(parsed.diagnostics.is_empty());
+        let mut checked = Checker::check_arena(&parsed.arena, source);
+        let (_, bodies) = checked_source_effect_bodies(
+            &parsed.arena,
+            parsed.arena.statement_ids(),
+            source,
+        ).unwrap();
+        assert_eq!(bodies.len(), 1);
+        let missing = *checked.function_effect_facts.keys().next().unwrap();
+        checked.function_effect_facts.remove(&missing);
+
+        let facts = parsed.arena.symbol_owner().with_current(|| {
+            checked_return_removal_facts_from_output(&checked, source_id, &bodies, &[], true)
+        });
+        assert!(facts.is_none());
+    }
+}
