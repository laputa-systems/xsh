+  let project = test.temp_dir(ctx, name: "argument-label-width")?
+  fp"{project}/xsht-config.ini".write("[format]\nline-width = 40\n")
+  let file = fp"{project}/main.xsh"
+  let source = r"""let target_path_from_inputs = fp"{args[0]}"
+let link_path_destination = fp"{args[1]}"
+# Keep this explanation of why the target is linked.
+fs.symlink(target_path_from_inputs, link_path_destination)
+assert link_path_destination.is_symlink()?
+print "linked"
+"""
+  file.write(source)
+  let before_dir = test.temp_dir(ctx, name: "argument-label-before")?
+  let after_dir = test.temp_dir(ctx, name: "argument-label-after")?
+  let before = test.expect(
+    ctx,
+    source,
+    status: 0,
+    stdout: ["linked"],
+    args: [fp"{before_dir}/target", fp"{before_dir}/link"],
+  )?
+
+  let reported = cd(project) { run.capture --text "xsht" lint "main.xsh" }?
+  assert reported.status.exited_with(1), reported.stderr
+  assert reported.stderr.split("warn[lint.prefer-argument-label]").len() == 2, reported.stderr
+  assert "`fs.symlink` takes the target first and the link second" in reported.stderr, reported.stderr
+  let fixed = cd(project) { run.capture --text "xsht" lint --fix "main.xsh" }?
+  assert fixed.status.exited_with(0), fixed.stderr
+  let expected = r"""let target_path_from_inputs = fp"{args[0]}"
+let link_path_destination = fp"{args[1]}"
+# Keep this explanation of why the target is linked.
+link_path_destination.symlink(
+  to: target_path_from_inputs,
+)
+assert link_path_destination.is_symlink()?
+print "linked"
