+  assert checked.status.exited_with(0), checked.stderr
+  let after = test.expect(
+    ctx,
+    file.read_text()?,
+    status: 0,
+    stdout: ["linked"],
+    args: [fp"{after_dir}/target", fp"{after_dir}/link"],
+  )?
+  assert before.stdout == after.stdout
+}
