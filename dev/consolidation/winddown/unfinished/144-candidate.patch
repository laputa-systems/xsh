+            let before_entries = ENTRY_CHECKS.with(std::cell::Cell::get);
+            let before_domain_probes = ENTRY_DOMAIN_PROBES.with(std::cell::Cell::get);
+            let before_entry_probes = ENTRY_EFFECT_PROBES.with(std::cell::Cell::get);
+            let before_module_probes = MODULE_EFFECT_PROBES.with(std::cell::Cell::get);
+            let before_record_misses = MODULE_RECORD_CACHE_MISSES.with(std::cell::Cell::get);
+            let before_owner_preparations = OWNER_FACTS_PREPARATIONS.with(std::cell::Cell::get);
+            let before_headers = MODULE_TYPE_HEADER_PREPARATIONS.with(std::cell::Cell::get);
