+                ENTRY_DOMAIN_PROBES.with(std::cell::Cell::get) - before_domain_probes,
+                ENTRY_EFFECT_PROBES.with(std::cell::Cell::get) - before_entry_probes,
+                MODULE_EFFECT_PROBES.with(std::cell::Cell::get) - before_module_probes,
+                MODULE_RECORD_CACHE_MISSES.with(std::cell::Cell::get) - before_record_misses,
+                OWNER_FACTS_PREPARATIONS.with(std::cell::Cell::get) - before_owner_preparations,
+                MODULE_TYPE_HEADER_PREPARATIONS.with(std::cell::Cell::get) - before_headers,
+                before_records.0,
+                after_records.0,
+                before_records.1,
+                after_records.1,
+                output.diagnostics.len(),
+                output.reveal_types.len(),
+            )
+            .expect("write attribution profile");
+            W9_PHASE_NANOS.with(|phases| {
+                for (phase, elapsed_nanos) in phases.borrow().iter() {
+                    writeln!(timing, "phase\t{name}\t{phase}\t{elapsed_nanos}")
+                        .expect("write phase attribution");
+                }
+            });
+            timing.flush().expect("flush attribution profile");
         }
     }
 }
