+                        .map(|value| value.retained_bytes().saturating_sub(size_of::<Self>()))
+                        .sum::<usize>();
+            }
+            Self::Set(values) => {
+                bytes += size_of::<BTreeSet<MapKey>>()
+                    + values.len() * size_of::<MapKey>()
+                    + values.iter().map(map_key_retained_bytes).sum::<usize>();
+            }
+            Self::Null
+            | Self::Bool(_)
+            | Self::Int(_)
+            | Self::Float(_)
+            | Self::Duration(_)
+            | Self::EmptyMap => {}
+        }
