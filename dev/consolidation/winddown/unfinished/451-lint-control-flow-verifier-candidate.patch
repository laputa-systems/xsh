+        let callback_has_parameter_name = |ty: &Type, wanted: &str| {
+            let Type::Record(fields) = ty else {
+                return false;
+            };
+            let Some(Type::Callable(callable)) = fields.get(&callback_name) else {
+                return false;
+            };
