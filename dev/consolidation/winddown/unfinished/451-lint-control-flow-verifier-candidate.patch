+  callbacks.len()
+}
+proc callback_from_literal_map() [error] -> Result[Int] {
+  let callbacks: Map[Str, Scale] = {["double"]: double}
+  with selected = callbacks.get("double") {
+    return Ok(selected(4))
+  } else { |failure| return Err(failure) }
+}
+pure map_value() -> Int {
+  let callbacks: Map[Str, Pure] = {["label"]: label_length}
+  callbacks.len()
+}
+pure noncallable_map_value() -> Int {
+  let callbacks: Map[Str, Int] = {["label"]: 1}
+  callbacks.len()
+}
+pure empty_map_value() -> Int {
+  let callbacks: Map[Str, Scale] = {}
+  callbacks.len()
+}
+pure list_value() -> Int {
+  let callbacks: List[Pure] = [label_length]
+  callbacks.len()
+}
+pure record_value() -> Pure {
+  let holder: Holder = {callback: label_length}
+  holder.callback
+}
+test test_typed_callable_literal_containers {
+  assert typed_map_value() == 1
+  assert callback_from_literal_map()? == 8
+  assert map_value() == 1
+  assert list_value() == 1
+}
+"#;
+        let program = fixture("typed-callable-literal-containers.xsh", source);
+        FullVerifier::verify(&program).unwrap();
+
+        let scale = Type::Callable(Arc::new(crate::sema::types::TypedCallable {
+            pure: true,
