+        let decoder = FullDecoder {
+            store: &program.store,
+            owner,
+            instruction_range: instruction_range.clone(),
+            instruction_states: Some(RefCell::new(vec![0; instruction_range.len()])),
+            instruction_proof: Some(RefCell::new(in_place::InstructionProof::new(
+                instruction_range,
