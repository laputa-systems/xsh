+                params: vec![crate::sema::types::CallableParamType {
+                    name: program_name(&program, "n"),
+                    ty: Type::Int,
+                    defaulted: false,
+                    rest: false,
+                }],
+                return_ty: Box::new(Type::Int),
+                effects: None,
+            },
+        }));
+        let mut record_fields = BTreeMap::new();
+        record_fields.insert(program_name(&program, "callback"), scale.clone());
+        let container_types = [
+            (
+                "map_value",
+                FullTag::ExprMapLiteral,
+                Type::Map(Box::new(Type::Str), Box::new(scale.clone())),
+            ),
+            (
+                "list_value",
+                FullTag::ExprList,
+                Type::List(Box::new(scale.clone())),
+            ),
+            ("record_value", FullTag::ExprRecord, Type::Record(record_fields)),
+        ];
+        for (function, tag, forged_type) in container_types {
+            let instructions = function_instruction_indices(&program, function, tag);
+            assert_eq!(instructions.len(), 1, "{function} has one {tag:?} producer");
+            let instruction = instructions[0];
+            assert!(
+                program
+                    .store
