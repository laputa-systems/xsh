+theorem inferred_expression_is_supported_checker_fragment
+    (names : LexicalEnvironment) (activations : ActivationEnvironment) (store : BaseStore)
+    (expression : BaseExpr) {type : BaseType}
+    (inferred : inferBaseType? names activations store expression = some type) :
+    checkBaseExpr names activations store expression = true := by
+  cases expression with
+  | integerLiteral value =>
+    cases valid : validateInt? value <;>
+      simp [inferBaseType?, checkBaseExpr, valid] at inferred ⊢
+  | scalarLiteral value =>
+    cases supported : scalarTypedValue? value <;>
+      simp [inferBaseType?, checkBaseExpr, supported] at inferred ⊢
+  | timeNow => rfl
+  | identifier name =>
+    cases found : lookupBaseValue names activations store name with
+    | error fault => simp [inferBaseType?, checkBaseExpr, found] at inferred
+    | ok typed =>
+      change (lookupBaseValue names activations store name).isOk = true
+      rw [found]
+      rfl
+  | negate operand =>
+    cases operandType : inferBaseType? names activations store operand with
+    | none => simp [inferBaseType?, operandType] at inferred
+    | some operandType =>
+      cases operandType <;>
+        simp [inferBaseType?, checkBaseExpr, checkIntegerExpr, operandType] at inferred ⊢
+  | binary operator left right =>
+    cases leftType : inferBaseType? names activations store left with
+    | none => simp [inferBaseType?, leftType] at inferred
+    | some leftTag =>
+      cases rightType : inferBaseType? names activations store right with
+      | none => simp [inferBaseType?, leftType, rightType] at inferred
+      | some rightTag =>
+        cases leftTag <;> cases rightTag <;>
+          simp [inferBaseType?, checkBaseExpr, checkIntegerExpr, leftType, rightType] at inferred ⊢
+  | scalarEquality operator left right =>
+    cases leftType : inferBaseType? names activations store left with
+    | none => simp [inferBaseType?, leftType] at inferred
+    | some leftTag =>
+      cases rightType : inferBaseType? names activations store right with
+      | none => simp [inferBaseType?, leftType, rightType] at inferred
+      | some rightTag =>
+        cases leftTag <;> cases rightTag <;>
+          simp [inferBaseType?, checkBaseExpr, leftType, rightType] at inferred ⊢
+
+theorem checked_scalar_equality_has_matching_operand_types
+    (names : LexicalEnvironment) (activations : ActivationEnvironment) (store : BaseStore)
+    (operator : ScalarEqualityOp) (left right : BaseExpr)
+    (accepted : checkBaseExpr names activations store (.scalarEquality operator left right) = true) :
+    ∃ type, inferBaseType? names activations store left = some type ∧
+      inferBaseType? names activations store right = some type := by
+  cases leftType : inferBaseType? names activations store left with
+  | none => simp [checkBaseExpr, leftType] at accepted
+  | some leftTag =>
+    cases rightType : inferBaseType? names activations store right with
+    | none => simp [checkBaseExpr, leftType, rightType] at accepted
+    | some rightTag =>
+      have tagsEqual : leftTag = rightTag :=
+        of_decide_eq_true (by simpa [checkBaseExpr, leftType, rightType] using accepted)
+      exact ⟨leftTag, leftType, by simpa [tagsEqual] using rightType⟩
+
+theorem checked_scalar_equality_infers_boolean
+    (names : LexicalEnvironment) (activations : ActivationEnvironment) (store : BaseStore)
+    (operator : ScalarEqualityOp) (left right : BaseExpr)
+    (accepted : checkBaseExpr names activations store (.scalarEquality operator left right) = true) :
+    inferBaseType? names activations store (.scalarEquality operator left right) =
+      some .boolean := by
+  obtain ⟨type, leftType, rightType⟩ :=
+    checked_scalar_equality_has_matching_operand_types names activations store
+      operator left right accepted
+  simp [inferBaseType?, leftType, rightType]
+
+theorem scalar_semantic_comparator_agrees
+    (left right : CompositeValue)
+    (leftScalar : (scalarTypedValue? left).isSome = true)
+    (rightScalar : (scalarTypedValue? right).isSome = true) :
+    scalarSemanticEqB left right = true ↔ left.semanticEq right := by
+  cases left <;> cases right <;>
+    simp [scalarTypedValue?, scalarSemanticEqB, CompositeValue.semanticEq,
+      float_value_eq_spec] at leftScalar rightScalar ⊢
+
+theorem scalar_semantic_neqb_is_boolean_complement (left right : CompositeValue) :
+    scalarSemanticNeqB left right = !(scalarSemanticEqB left right) := rfl
+
+theorem scalar_semantic_neqb_agrees
+    (left right : CompositeValue)
+    (leftScalar : (scalarTypedValue? left).isSome = true)
+    (rightScalar : (scalarTypedValue? right).isSome = true) :
+    scalarSemanticNeqB left right = true ↔ ¬ left.semanticEq right := by
+  constructor
+  · intro notEqual equal
+    have equalB := (scalar_semantic_comparator_agrees left right leftScalar rightScalar).2 equal
+    simp [scalarSemanticNeqB, equalB] at notEqual
+  · intro notEqual
+    cases equalB : scalarSemanticEqB left right with
+    | false => simp [scalarSemanticNeqB, equalB]
+    | true => exact False.elim (notEqual
+        ((scalar_semantic_comparator_agrees left right leftScalar rightScalar).1 equalB))
 
