+#[cfg(test)]
+mod tests {
+    use super::{Gen, GenConfig, finish};
+    use crate::ast::{BinOp, Block, Elem, Expr, Program, Stmt, Ty};
+    use crate::rng::Rng;
+
+    #[test]
+    fn bool_equality_operand_types_include_float_and_nested_float_lists() {
+        let config = GenConfig::default();
+        let mut generated = Vec::new();
+        for seed in 0..128 {
+            let mut gen = Gen::new(Rng::new(seed), &config);
+            generated.push(gen.equality_operand_ty());
+        }
+
+        assert!(generated.contains(&Ty::Float));
+        assert!(generated.contains(&Ty::list(Ty::Float)));
+        assert!(generated.contains(&Ty::list(Ty::list(Ty::Float))));
+    }
+
+    #[test]
+    fn float_literals_include_both_signed_zeroes() {
+        let config = GenConfig::default();
+        let mut positive_zero = false;
+        let mut negative_zero = false;
+        for seed in 0..128 {
+            let mut gen = Gen::new(Rng::new(seed), &config);
+            let Expr::Float(value) = gen.literal(&Ty::Float, false, 0) else {
+                unreachable!()
+            };
+            if value == 0.0 {
+                if value.is_sign_negative() {
+                    negative_zero = true;
+                } else {
+                    positive_zero = true;
+                }
+            }
+        }
+
+        assert!(positive_zero);
+        assert!(negative_zero);
+    }
+
+    #[test]
+    fn signed_zero_equality_witnesses_are_filled_into_generated_assertions() {
+        let binary = |op, left, right| Expr::Binary(op, Box::new(left), Box::new(right));
+        let compare = |op| Stmt::AssertEq {
+            expr: binary(op, Expr::Float(0.0), Expr::Float(-0.0)),
+            expected: None,
+        };
+        let nested = |op| {
+            let list = |value| {
+                Expr::List(vec![Elem::Item(Expr::List(vec![Elem::Item(Expr::Float(
+                    value,
+                ))]))])
+            };
+            Stmt::AssertEq {
+                expr: binary(op, list(0.0), list(-0.0)),
+                expected: None,
+            }
+        };
+        let generated = finish(
+            0,
+            Program {
+                consts: Vec::new(),
+                records: Vec::new(),
+                enums: Vec::new(),
+                functions: Vec::new(),
+                body: Block {
+                    stmts: vec![
+                        compare(BinOp::Eq),
+                        compare(BinOp::Ne),
+                        nested(BinOp::Eq),
+                        nested(BinOp::Ne),
+                    ],
+                    tail: None,
+                },
+            },
+        )
+        .expect("finite signed-zero witnesses are evaluable");
+
+        assert!(generated.source.contains("assert (0.0 == -0.0) == true"));
+        assert!(generated.source.contains("assert (0.0 != -0.0) == false"));
+        assert!(generated.source.contains("assert ([[0.0]] == [[-0.0]]) == true"));
+        assert!(generated.source.contains("assert ([[0.0]] != [[-0.0]]) == false"));
+    }
+}
