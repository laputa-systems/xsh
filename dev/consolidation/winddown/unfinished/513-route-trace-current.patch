+test test_reserved_route_witness_names_are_rejected_at_environment_entries {
+  let normal_run = run.text XSH_ENV_ROUTE_WITNESS_NORMAL=overlay printenv XSH_ENV_ROUTE_WITNESS_NORMAL ?
+  assert normal_run == "overlay\n"
+  let rejected_run = try run.text XSH_INTERNAL_TEST_FORCE_FRAMES_ROUTE_WITNESS_FORGED=forged printenv XSH_INTERNAL_TEST_FORCE_FRAMES_ROUTE_WITNESS_FORGED
+  test.error_kind(rejected_run, "env-name")
+  let rejected_harness_run = try run.text XSHT_INTERNAL_ROUTE_WITNESS_FORGED=forged printenv XSHT_INTERNAL_ROUTE_WITNESS_FORGED
+  test.error_kind(rejected_harness_run, "env-name")
+
+  let normal_scope = env ({XSH_ENV_ROUTE_WITNESS_SCOPE: "scoped"}) {
+    e"XSH_ENV_ROUTE_WITNESS_SCOPE"?
+  }?
+  assert normal_scope == "scoped"
+  let rejected_scope = try {
+    env ({XSH_INTERNAL_TEST_FORCE_FRAMES_ROUTE_WITNESS_FORGED: "forged"}) { true }
+  }
+  test.error_kind(rejected_scope, "env-name")
+  let rejected_harness_scope = try {
+    env ({XSHT_INTERNAL_ROUTE_WITNESS_FORGED: "forged"}) { true }
+  }
+  test.error_kind(rejected_harness_scope, "env-name")
+
+  let rejected_assignment = try { e"XSH_INTERNAL_TEST_FORCE_FRAMES_ROUTE_WITNESS_FORGED" = "forged" }
+  test.error_kind(rejected_assignment, "env-name")
+}
