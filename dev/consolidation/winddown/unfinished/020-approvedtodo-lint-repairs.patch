+test test_optional_fallback_fix_removes_the_grouping_with_it { |ctx|
+  let source = r"""# The guard keeps the optional value present for this arithmetic.
+pure increment(value: Int?) -> Int {
+  guard value != null else { return 0 }
+  (value ?? 0) + 1
+}
+print increment(1)
+print increment(null)
+"""
+  let before = test.expect(ctx, source, status: 0, stdout: ["2", "0"])?
+  let file = test.temp_file(ctx, name: "optional-fallback.xsh", contents: bytes.from_text(source))?
+  let reported = cd(file.parent()) { run.capture --text "xsht" lint $file }?
+  assert reported.status.exited_with(1), reported.stderr
+  assert reported.stderr.split("warn[lint.redundant-optional-fallback]").len() == 2, reported.stderr
+  assert "this Optional receiver is proved present" in reported.stderr, reported.stderr
+
+  let fixed = cd(file.parent()) { run.capture --text "xsht" lint --fix $file }?
+  assert fixed.status.exited_with(0), fixed.stderr
+  let expected = r"""# The guard keeps the optional value present for this arithmetic.
+pure increment(value: Int?) -> Int {
+  guard value != null else { return 0 }
+  value + 1
+}
+
+print increment(1)
+print increment(null)
+"""
+  assert file.read_text()? == expected, file.read_text()?
+  assert "check.redundant-parens" not in fixed.stderr, fixed.stderr
+  let checked = run.capture --text "xsht" check $file
+  assert checked.status.exited_with(0), checked.stderr
+  let remaining = cd(file.parent()) { run.capture --text "xsht" lint $file }?
+  assert remaining.status.exited_with(0), remaining.stderr
+  assert "check.redundant-parens" not in remaining.stderr, remaining.stderr
+  let after = test.expect(ctx, file.read_text()?, status: 0, stdout: ["2", "0"])?
+  assert before.stdout == "2\n0\n", before.stdout
+  assert after.stdout == before.stdout, after.stdout
+}
