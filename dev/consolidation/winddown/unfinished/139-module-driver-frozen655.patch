+#[test]
+fn temporary_repository_checker_digest() {
+    fn update(digest: &mut u64, bytes: &[u8]) {
+        for byte in bytes {
+            *digest = (*digest ^ u64::from(*byte)).wrapping_mul(0x100000001b3);
+        }
+    }
+
+    let root = Path::new(env!("CARGO_MANIFEST_DIR"));
+    let sources = repository_xsh_sources();
+    let options = [
+        CheckOptions::default(),
+        CheckOptions {
+            reveal_types: true,
+            ..CheckOptions::default()
+        },
+        CheckOptions::for_execution(),
+        CheckOptions::for_check_cli(),
+    ];
+    let mut digest = 0xcbf29ce484222325;
+    for path in &sources {
+        let relative = path.strip_prefix(root).expect("corpus path is relative to the repository");
+        let name = relative.to_string_lossy();
+        let source = std::fs::read_to_string(path)
+            .unwrap_or_else(|error| panic!("read {}: {error}", path.display()));
+        let mut file_digest = 0xcbf29ce484222325;
+        update(&mut file_digest, name.as_bytes());
+        update(&mut file_digest, source.as_bytes());
+        update(&mut digest, name.as_bytes());
+        update(&mut digest, source.as_bytes());
+        let parsed = Parser::parse_source_arena_only(SourceId::new(0), &source);
+        for (index, options) in options.iter().copied().enumerate() {
+            update(&mut digest, &[index as u8]);
+            let diagnostics = parsed.arena.symbol_owner().with_current(|| {
+                let checked = Checker::check_arena_with_options(&parsed.arena, &source, options);
+                let mut diagnostics = parsed.diagnostics.clone();
+                diagnostics.extend(checked.diagnostics);
+                diagnostics
+            });
+            let rendered = format!("{diagnostics:?}");
+            update(&mut digest, rendered.as_bytes());
+            update(&mut file_digest, &[index as u8]);
+            update(&mut file_digest, rendered.as_bytes());
+        }
+        println!("source={name} digest={file_digest:016x}");
+    }
+    println!("repository-sources={} checker-digest={digest:016x}", sources.len());
+}
