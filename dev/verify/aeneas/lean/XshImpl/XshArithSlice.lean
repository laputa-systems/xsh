def duration.DurationArithmeticError.diagnostic
  (self : duration.DurationArithmeticError) : Result (Str × Str) := do
  match self with
  | duration.DurationArithmeticError.InvalidDimensions =>
    ok (toStr "type-error", toStr "invalid Duration arithmetic dimensions")
  | duration.DurationArithmeticError.Overflow =>
    ok (toStr "duration-overflow", toStr
      "Duration arithmetic exceeds representable milliseconds")
  | duration.DurationArithmeticError.Underflow =>
    ok (toStr "duration-underflow", toStr
      "Duration subtraction would be negative")
  | duration.DurationArithmeticError.NegativeFactor =>
    ok (toStr "duration-negative-factor", toStr
      "Duration multiplier must be nonnegative")
  | duration.DurationArithmeticError.NonpositiveDivisor =>
    ok (toStr "division-by-zero", toStr "Duration divisor must be positive")
  | duration.DurationArithmeticError.CountOverflow =>
    ok (toStr "integer-overflow", toStr "Duration interval count exceeds Int")

