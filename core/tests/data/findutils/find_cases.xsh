##! Command lines compared against GNU find. See regen.xsh for the flags; the
##! paths are relative to the directory holding the fixture trees.
use core.lib.findutils_fixture as fixture

pure c(name: Str, flags: Str, args: List[Str]) -> fixture.Case {
  {name: name, flags: flags, input: b"", args: args}
}

pure ci(name: Str, flags: Str, input: Bytes, args: List[Str]) -> fixture.Case {
  {name: name, flags: flags, input: input, args: args}
}

## Every case of the corpus, in a stable order.
export pure all() -> List[fixture.Case] {
  [
    c("name_exact", "s", ["tree", "-name", "a.txt"]),
    c("name_glob", "s", ["tree", "-name", "*.txt"]),
    c("name_iname", "s", ["tree", "-iname", "*.txt"]),
    c("name_class", "s", ["tree", "-name", "[ab]*"]),
