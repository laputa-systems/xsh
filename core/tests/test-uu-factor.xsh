# origin: uutils test_factor::test_parallel
test test_uu_factor_parallel { |ctx|
  let s = uu.scene(ctx)?
  uu.touch(s, "output")?
  let input = integer_input(50000)
  let children = collect {
    for index in range(8) {
      let plan = uu.command(s, "factor", [], input,
        stdout: uu.at(s, "output"), stderr: uu.at(s, f"stderr-{index}"),
        stdout_append: true)?
      yield spawn plan?
    }
  }
  for child in children {
    assert (wait child?).exited_with(0)
  }
  let sorted = uu.invoke(s, "sort", [uu.at(s, "output").display()])?
  uu.succeeds(sorted)
  assert hash.sha1(sorted.stdout).hex() == "73f104b140449feac7ccf27b4c13ef6b9a4c5ee4"
}
