#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
out=${1:-"$root/target/frontend-campaign/phase-5"}
phase4="$root/target/frontend-campaign/phase-4"
mkdir -p "$out"
cd "$root"

cat > "$out/PROTOCOL.md" <<'EOF'
# Frontend Campaign Phase 5 Protocol

Hypothesis: A compact coherent-region driver can make every top-level effect
and state transition explicit without retaining general AST evaluation,
silently falling back inside a committed program, changing product behavior,
or increasing production allocation traffic.

The strategy comparison models three boundaries over the same checked corpus:
one whole-program region with honest whole-program rejection, coherent regions
that isolate explicit effect boundaries, and the current arena orchestration
shape. The selected plan combines honest whole-program admission with coherent
regions. Unsupported executable top-level statements reject the complete
driver; declaration-only statements become explicit compact skip rows.

Every driver step owns an exact instruction range, source location, compact
slot rows, and effect bitset. Regions are source-ordered ranges with the union
of their read/write synchronization rows. Imports, cwd/env mutation, process
work, signal/cancellation checkpoints, trace-sensitive operations, dynamic
calls, defers, propagation, host operations, and binding reads/writes are
explicit. The verifier decodes every payload, checks exact effects and sync
unions, and rejects sharing, cycles, unreachable rows, invalid ownership, and
any hidden executable gap.

Phase 5 remains outside production until the Phase 6 cutover, so all three
candidate strategies are within production latency/allocation noise: none is
constructed by a product benchmark. The corpus structural comparison therefore
chooses the coherent plan for its explicit boundaries and compact ownership.
Two serial memory suites and two multi-sample latency suites verify that the
test-only boundary does not perturb production. Process/runtime owner files
remain unchanged; Linux syscall evidence is captured when Docker/strace is
available.
EOF

cp FRONTEND-CAMPAIGN.md "$out/FRONTEND-CAMPAIGN.md"

cargo test -p xsh --lib runtime::eval::indexed::full::tests:: \
  -- --test-threads=1 > "$out/tests.txt" 2>&1
cargo test -p xsh --lib \
  runtime::eval::indexed::full::tests::corpus_phase5_boundary_strategy_evidence \
  -- --ignored --exact --nocapture --test-threads=1 \
  > "$out/strategy-corpus.txt" 2>&1
rg 'phase5 corpus .*' "$out/strategy-corpus.txt" > "$out/strategy-summary.txt"
rg 'phase5 strategy=.*' "$out/strategy-corpus.txt" > "$out/strategies.txt"
rg 'phase5 effect .*' "$out/strategy-corpus.txt" > "$out/effects.txt"
rg 'phase5 blocker .*' "$out/strategy-corpus.txt" > "$out/blockers.txt"

scripts/ir-layout.py \
  --only FullDriverTag \
  --only FullDriverStep \
  --only FullDriverSlot \
  --only FullDriverSync \
  --only FullDriverRegion \
  --only FullDriverProgram > "$out/ir-layout.txt"

cargo build -p xsh --bin xsh --bin xsh-frontend-stats
target/debug/xsh-frontend-stats --json \
  tests/fixtures/frontend-campaign/vertical-slice.xsh \
  tests/fixtures/frontend-campaign/vertical-slice-unsupported.xsh \
  > "$out/frontend-stats-vertical-slice.json"
if test -f "$phase4/frontend-stats-vertical-slice.json"; then
  cmp "$phase4/frontend-stats-vertical-slice.json" \
    "$out/frontend-stats-vertical-slice.json"
  printf 'matches phase 4\n' > "$out/frontend-stats-comparison.txt"
else
  printf 'phase 4 artifact unavailable; the Phase 5 driver is test-only\n' \
    > "$out/frontend-stats-comparison.txt"
fi

target/debug/xsh tools/xsh-ir-coverage.xsh -- \
  --root . --json "$out/coverage.json" > "$out/coverage.txt"
if test -f "$phase4/coverage.json"; then
  cmp "$phase4/coverage.json" "$out/coverage.json"
  printf 'matches phase 4\n' > "$out/coverage-comparison.txt"
else
  printf 'phase 4 artifact unavailable\n' > "$out/coverage-comparison.txt"
fi

fast_baseline="$out/bench-fast.tsv"
scripts/bench-baseline.py --fast --baseline "$fast_baseline" \
  > "$out/bench-fast-1.txt" 2>&1
cp "$fast_baseline" "$out/bench-fast-1.tsv"
scripts/bench-baseline.py --fast --baseline "$fast_baseline" \
  > "$out/bench-fast-2.txt" 2>&1
cp "$fast_baseline" "$out/bench-fast-2.tsv"
awk '!/^#/ {print $1, $3, $4, $5, $6}' "$out/bench-fast-1.tsv" \
  > "$out/bench-fast-1-memory.txt"
awk '!/^#/ {print $1, $3, $4, $5, $6}' "$out/bench-fast-2.tsv" \
  > "$out/bench-fast-2-memory.txt"
cmp "$out/bench-fast-1-memory.txt" "$out/bench-fast-2-memory.txt"

latency_baseline="$out/bench-latency.tsv"
scripts/bench-baseline.py --baseline "$latency_baseline" \
  --warmup-runs 1 --runs 2 > "$out/bench-latency-1.txt" 2>&1
cp "$latency_baseline" "$out/bench-latency-1.tsv"
scripts/bench-baseline.py --baseline "$latency_baseline" \
  --warmup-runs 1 --runs 2 > "$out/bench-latency-2.txt" 2>&1
cp "$latency_baseline" "$out/bench-latency-2.tsv"

git diff --exit-code -- src/runtime/process.rs src/runtime/run.rs \
  > "$out/process-owner-diff.txt"
if test "$(uname -s)" = Linux && command -v docker >/dev/null 2>&1; then
  make bench-syscalls > "$out/bench-syscalls.txt" 2>&1
else
  printf 'syscall capture unavailable on this host; process/runtime owners are unchanged and the Phase 5 driver is not constructed in production\n' \
    > "$out/bench-syscalls.txt"
fi

rg -n \
  'FullDriver(Tag|Step|Slot|Sync|Region|Program)|EFFECT_|encode_driver|decode_driver' \
  src/runtime/eval/indexed/full.rs > "$out/driver-ownership.txt"
wc -l \
  src/runtime/eval/indexed/full.rs \
  src/runtime/eval/lower.rs \
  src/runtime/eval/lowered_run.rs > "$out/line-counts.txt"
{
  date -u '+date_utc=%Y-%m-%dT%H:%M:%SZ'
  uname -a
  rustc -vV
  git -C "$root/../../zig" rev-parse HEAD 2>/dev/null || true
} > "$out/host.txt"

printf 'phase 5 evidence written to %s\n' "$out"
