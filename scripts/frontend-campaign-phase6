#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
out=${1:-"$root/target/frontend-campaign/phase-6"}
phase5="$root/target/frontend-campaign/phase-5"
mkdir -p "$out"
cd "$root"

cat > "$out/PROTOCOL.md" <<'EOF'
# Frontend Campaign Phase 6 Protocol

Hypothesis: The verified indexed program and driver can be the only executable
lowered representation without changing user-visible behavior or regressing the
curated fast benchmark, while deleting the recursive evaluator, arena-oracle
runner, recursive registries, compatibility maps, and body-retaining probes.

The structural gate rejects the deleted recursive type names, arena execution
mode, and recursive evaluator entry points anywhere in Rust, XSH, Python, or
shell sources. Direct indexed tests freeze values, output, errors, locations,
traces, driver effects, loaded modules, signal hooks, and verifier failures.
The complete runtime integration gate and native XSH test corpus then exercise
the production entry, tooling trace entry, dynamic modules, host operations,
process work, streams, and native-test preparation through indexed execution.

The layout report records only finalized indexed rows and the runtime evaluator.
Two serial fast benchmark suites verify stable allocation and peak-live results;
the Phase 5 captures remain the pre-deletion comparison when available. PGO
remains deferred until all non-PGO campaign phases produce a stable release
candidate.
EOF

cp FRONTEND-CAMPAIGN.md "$out/FRONTEND-CAMPAIGN.md"

if rg -n \
  '\b(LoweredExpr|LoweredStmt|LoweredPattern|LoweredPureFunction|LoweredProgram|LoweredTopLevelStmt)\b|XSH_TEST_EXECUTION_MODE|CompactExecutionMode|eval_lowered_(function|stmt|stmts|expr|typed_int|typed_bool)' \
  --glob '*.rs' --glob '*.xsh' --glob '*.py' --glob '*.sh' \
  --glob '!frontend-campaign-phase6' \
  src crates tests tools scripts > "$out/deleted-boundary.txt"; then
  printf 'deleted recursive execution boundary still exists\n' >&2
  exit 1
fi

cargo test -p xsh runtime::eval::indexed::full::tests --lib \
  --features native-tests > "$out/indexed-tests.txt" 2>&1
cargo test -p xsh runner::tests --lib \
  --features native-tests > "$out/runner-tests.txt" 2>&1
cargo test -p xsh --test integration runtime:: --features native-tests \
  -- --test-threads=1 \
  > "$out/runtime-tests.txt" 2>&1
cargo test -p xsh --test integration \
  runtime::coverage::xsh_native_tests --features native-tests -- \
  --exact --test-threads=1 \
  > "$out/native-tests.txt" 2>&1

scripts/ir-layout.py \
  --only FullTag \
  --only FullBlock \
  --only FullFunction \
  --only FullDriverStep \
  --only FullDriverRegion \
  --only Evaluator > "$out/ir-layout.txt"

cargo build -p xsh --bin xsh --bin xsh-frontend-stats
target/debug/xsh-frontend-stats --json \
  tests/fixtures/frontend-campaign/vertical-slice.xsh \
  tests/fixtures/frontend-campaign/vertical-slice-unsupported.xsh \
  > "$out/frontend-stats-vertical-slice.json"
target/debug/xsh tools/xsh-ir-coverage.xsh -- \
  --root . --json "$out/coverage.json" > "$out/coverage.txt"

fast_baseline="$out/bench-fast.tsv"
scripts/bench-baseline.py --fast --baseline "$fast_baseline" \
  > "$out/bench-fast-1.txt" 2>&1
cp "$fast_baseline" "$out/bench-fast-1.tsv"
scripts/bench-baseline.py --fast --baseline "$fast_baseline" \
  > "$out/bench-fast-2.txt" 2>&1
cp "$fast_baseline" "$out/bench-fast-2.tsv"
awk '!/^#/ {print $1, $3, $4, $5, $6}' "$out/bench-fast-1.tsv" \
  > "$out/bench-fast-1-memory.txt"
awk '!/^#/ {print $1, $3, $4, $5, $6}' "$out/bench-fast-2.tsv" \
  > "$out/bench-fast-2-memory.txt"
cmp "$out/bench-fast-1-memory.txt" "$out/bench-fast-2-memory.txt"
if test -f "$phase5/bench-fast-2-memory.txt"; then
  diff -u "$phase5/bench-fast-2-memory.txt" "$out/bench-fast-2-memory.txt" \
    > "$out/bench-fast-phase5-memory.diff" || true
fi

{
  printf 'before '
  git show HEAD:src/runtime/eval.rs | wc -l
  printf 'after  '
  wc -l < src/runtime/eval.rs
  printf 'before '
  git show HEAD:src/runtime/eval/lowered_run.rs | wc -l
  printf 'after  '
  wc -l < src/runtime/eval/lowered_run.rs
  printf 'before '
  git show HEAD:src/runtime/eval/tests.rs | wc -l
  printf 'after  0\n'
} > "$out/line-counts.txt"

{
  date -u '+date_utc=%Y-%m-%dT%H:%M:%SZ'
  uname -a
  rustc -vV
  git -C "$root/../../zig" rev-parse HEAD 2>/dev/null || true
} > "$out/host.txt"

printf 'phase 6 evidence written to %s\n' "$out"
