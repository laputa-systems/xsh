#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
out=${1:-"$root/target/frontend-campaign/phase-4"}
phase0="$root/target/frontend-campaign/phase-0"
phase3="$root/target/frontend-campaign/phase-3"
local_before="$root/target/frontend-campaign/phase-4/before"
mkdir -p "$out"
cd "$root"

cat > "$out/PROTOCOL.md" <<'EOF'
# Frontend Campaign Phase 4 Protocol

Hypothesis: Encoding every committed lowered expression, statement, pattern,
pipeline stage, function, parameter, capture, literal, semantic identity, and
source location in verified indexed tables will reduce retained executable
storage by at least 20% relative to the recursive rows alone, without changing
production coverage, allocation traffic, peak live bytes, values, output,
errors, or normalized traces.

The finalized store uses one-byte opcode columns, eight-byte instruction data,
shared `u32` extra storage, explicit block rows, and checked one-based `u32`
identities. Function bodies and every nested statement sequence use owned block
IDs. Parameter defaults and validations live in a sparse cold table. Recovery
checker types are converted to their existing executable wildcard meaning,
`Any`, before interning; recovery identities remain forbidden.

The corpus test includes only files for which every function body was committed
by the production compact lowerer. It decodes and verifies every function,
reports every observed opcode, and compares finalized retained bytes with a
conservative recursive-row lower bound that excludes recursive vector, box,
string, map, and semantic-type heap storage. The frozen vertical slice remains
the execution oracle for exact values, output, errors, locations, and normalized
traces.

The compact program is test-only during migration. Production does not build a
shadow store. When historical target artifacts are present, frontend stats,
coverage, and the mediated `make bench-fast` memory table compare directly with
them. Otherwise coverage compares with the frozen local pre-change capture and
two serial benchmark runs must have identical allocation traffic.
EOF

cp FRONTEND-CAMPAIGN.md "$out/FRONTEND-CAMPAIGN.md"

cargo test -p xsh --lib runtime::eval::indexed::full::tests:: \
  -- --test-threads=1 > "$out/tests.txt" 2>&1
cargo test -p xsh --lib \
  runtime::eval::indexed::full::tests::corpus_full_indexed_store_evidence \
  -- --ignored --nocapture --test-threads=1 > "$out/corpus-ir.txt" 2>&1
rg 'phase4 corpus .*' "$out/corpus-ir.txt" > "$out/corpus-ir-summary.txt"
rg 'phase4 opcode .*' "$out/corpus-ir.txt" > "$out/opcode-frequency.txt"
rg 'phase4 blocker .*' "$out/corpus-ir.txt" > "$out/blockers.txt"

scripts/ir-layout.py > "$out/ir-layout.txt"

cargo build -p xsh --bin xsh --bin xsh-frontend-stats
target/debug/xsh-frontend-stats --json \
  tests/fixtures/frontend-campaign/vertical-slice.xsh \
  tests/fixtures/frontend-campaign/vertical-slice-unsupported.xsh \
  > "$out/frontend-stats-vertical-slice.json"
if test -f "$phase0/frontend-stats-vertical-slice.json"; then
  cmp "$phase0/frontend-stats-vertical-slice.json" \
    "$out/frontend-stats-vertical-slice.json"
  printf 'matches phase 0\n' > "$out/frontend-stats-comparison.txt"
else
  printf 'phase 0 artifact unavailable; Phase 4 code is not constructed by the production stats path\n' \
    > "$out/frontend-stats-comparison.txt"
fi

target/debug/xsh tools/xsh-ir-coverage.xsh -- \
  --root . --json "$out/coverage.json" > "$out/coverage.txt"
if test -f "$phase0/coverage.json"; then
  cmp "$phase0/coverage.json" "$out/coverage.json"
  printf 'matches phase 0\n' > "$out/coverage-comparison.txt"
else
  cmp "$local_before/coverage.json" "$out/coverage.json"
  printf 'matches the frozen local pre-Phase-4 capture\n' \
    > "$out/coverage-comparison.txt"
fi

baseline=$(scripts/bench-baseline.py --fast --print-path)
make bench-fast > "$out/bench-fast-1.txt" 2>&1
cp "$baseline" "$out/bench-fast-1.tsv"
make bench-fast > "$out/bench-fast-2.txt" 2>&1
cp "$baseline" "$out/bench-fast-2.tsv"
awk '!/^#/ {print $1, $3, $4, $5, $6}' "$out/bench-fast-1.tsv" \
  > "$out/bench-fast-1-memory.txt"
awk '!/^#/ {print $1, $3, $4, $5, $6}' "$out/bench-fast-2.tsv" \
  > "$out/bench-fast-2-memory.txt"

python3 - "$out/bench-fast-1-memory.txt" "$out/bench-fast-2-memory.txt" \
  > "$out/bench-fast-mediated-memory.txt" <<'PY'
import sys


def rows(path):
    parsed = {}
    with open(path, encoding="utf-8") as handle:
        for line in handle:
            name, alloc_count, alloc_bytes, peak_count, peak_bytes = line.split()
            parsed[name] = tuple(
                map(int, (alloc_count, alloc_bytes, peak_count, peak_bytes))
            )
    return parsed


first = rows(sys.argv[1])
second = rows(sys.argv[2])
if first.keys() != second.keys():
    raise SystemExit("benchmark rows changed")
for name in first:
    first_alloc_count, first_alloc_bytes, first_peak_count, first_peak_bytes = first[name]
    second_alloc_count, second_alloc_bytes, second_peak_count, second_peak_bytes = second[name]
    if (first_alloc_count, first_alloc_bytes) != (
        second_alloc_count,
        second_alloc_bytes,
    ):
        raise SystemExit(f"allocation traffic changed between Phase 4 runs for {name}")
    print(
        name,
        first_alloc_count,
        first_alloc_bytes,
        max(first_peak_count, second_peak_count),
        max(first_peak_bytes, second_peak_bytes),
    )
PY
if test -f "$phase3/bench-fast-mediated-memory.txt"; then
  cmp "$phase3/bench-fast-mediated-memory.txt" \
    "$out/bench-fast-mediated-memory.txt"
  printf 'matches phase 3\n' > "$out/bench-fast-comparison.txt"
else
  printf 'phase 3 artifact unavailable; both Phase 4 runs have identical allocation traffic\n' \
    > "$out/bench-fast-comparison.txt"
fi

rg -n \
  'Full(Tag|Store|Program|Block|Function|Param|Capture|Verifier)|impl_node_codec|impl_stage_codec|impl_vec_codec' \
  src/runtime/eval/indexed/full.rs > "$out/full-ir-ownership.txt"
wc -l \
  src/runtime/eval/indexed.rs \
  src/runtime/eval/indexed/full.rs \
  src/runtime/eval/indexed/semantic.rs \
  src/runtime/eval/lower.rs > "$out/line-counts.txt"
{
  date -u '+date_utc=%Y-%m-%dT%H:%M:%SZ'
  uname -a
  rustc -vV
  git -C "$root/../../zig" rev-parse HEAD 2>/dev/null || true
} > "$out/host.txt"

printf 'phase 4 evidence written to %s\n' "$out"
