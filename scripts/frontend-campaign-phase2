#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
out=${1:-"$root/target/frontend-campaign/phase-2"}
phase0="$root/target/frontend-campaign/phase-0"
phase1="$root/target/frontend-campaign/phase-1"
mkdir -p "$out"
cd "$root"

cat > "$out/PROTOCOL.md" <<'EOF'
# Frontend Campaign Phase 2 Protocol

Phase 2 remains test-only. Function identities and parameter/capture metadata
are created before bodies. A separate dependency pass scans committed lowered
bodies, computes one compact graph and Tarjan SCC partition, then emits SCCs in
dependency order.

Rows beyond the commit watermark are scratch. Function bodies remain pending
until partial verification succeeds for the whole SCC. Failure clears pending
bodies and rewinds every store column. Structured blockers carry function ID,
label, detail, source location, and optional callee; coverage counts and samples
derive from blocker records, never blocker counters.

Production coverage JSON and structural frontend stats must match Phase 0.
Two `make bench-fast` runs are mediated by taking each row's maximum peak count
and bytes; the mediated memory table must match Phase 1 exactly. Wall time is
telemetry only.
EOF

cargo test -p xsh --lib runtime::eval::indexed::tests:: \
  -- --test-threads=1 > "$out/tests.txt" 2>&1
cargo test -p xsh --lib \
  runtime::eval::indexed::tests::dependency_graph_finds_self_and_mutual_recursion_before_emission \
  -- --nocapture --test-threads=1 > "$out/vertical-graph.txt" 2>&1
cargo test -p xsh --lib \
  runtime::eval::indexed::tests::structured_blockers_preserve_label_callee_and_sample_location \
  -- --nocapture --test-threads=1 > "$out/blocker-detail.txt" 2>&1
cargo test -p xsh --lib \
  runtime::eval::indexed::tests::corpus_graph_scc_and_blocker_evidence \
  -- --ignored --nocapture --test-threads=1 > "$out/corpus-graph.txt" 2>&1

rg -o 'phase2 vertical .*' "$out/vertical-graph.txt" > "$out/vertical-graph-summary.txt"
rg -o 'phase2 blocker .*' "$out/blocker-detail.txt" > "$out/blocker-detail-summary.txt"
rg -o 'phase2 (corpus|blocker_count|blocker_callee) .*' "$out/corpus-graph.txt" \
  > "$out/corpus-graph-summary.txt"
scripts/ir-layout.py > "$out/ir-layout.txt"

cargo build -p xsh --bin xsh --bin xsh-frontend-stats
target/debug/xsh-frontend-stats --json \
  tests/fixtures/frontend-campaign/vertical-slice.xsh \
  tests/fixtures/frontend-campaign/vertical-slice-unsupported.xsh \
  > "$out/frontend-stats-vertical-slice.json"

python3 - "$phase0/frontend-stats-vertical-slice.json" \
  "$out/frontend-stats-vertical-slice.json" > "$out/frontend-stats-comparison.txt" <<'PY'
import json
import sys


def rows(path):
    with open(path, encoding="utf-8") as handle:
        report = json.load(handle)
    return {row["path"].rsplit("/", 1)[-1]: row for row in report["files"]}


before = rows(sys.argv[1])
after = rows(sys.argv[2])
keys = [
    "source_bytes",
    "token_count",
    "token_retained_bytes",
    "cst_node_count",
    "cst_retained_bytes",
    "ast_stmt_count",
    "ast_expr_count",
    "ast_pattern_count",
    "ast_type_count",
    "ast_extra_items",
    "ast_retained_bytes",
    "semantic_type_count",
    "semantic_retained_bytes",
    "source_map_retained_bytes",
    "lowered_function_count",
    "lowered_constructed_functions",
    "lowered_statement_count",
    "lowered_expression_count",
    "lowered_pattern_count",
    "lowered_retained_bytes",
    "lowered_blocker_events",
    "diagnostics",
    "components_sum",
    "reported_total_bytes",
    "reconcile_delta",
]
if before.keys() != after.keys():
    raise SystemExit("vertical-slice rows changed")
for name in before:
    changed = [key for key in keys if before[name][key] != after[name][key]]
    if changed:
        raise SystemExit(f"frontend structural stats changed for {name}: {changed}")
print("frontend structural and lowered retained columns match Phase 0")
PY

target/debug/xsh tools/xsh-ir-coverage.xsh -- \
  --root . --json "$out/coverage.json" > "$out/coverage.txt"
cmp "$phase0/coverage.json" "$out/coverage.json"

baseline=$(scripts/bench-baseline.py --fast --print-path)
make bench-fast > "$out/bench-fast-1.txt" 2>&1
cp "$baseline" "$out/bench-fast-1.tsv"
make bench-fast > "$out/bench-fast-2.txt" 2>&1
cp "$baseline" "$out/bench-fast-2.tsv"
awk '!/^#/ {print $1, $3, $4, $5, $6}' "$out/bench-fast-1.tsv" \
  > "$out/bench-fast-1-memory.txt"
awk '!/^#/ {print $1, $3, $4, $5, $6}' "$out/bench-fast-2.tsv" \
  > "$out/bench-fast-2-memory.txt"

python3 - "$out/bench-fast-1-memory.txt" "$out/bench-fast-2-memory.txt" \
  > "$out/bench-fast-mediated-memory.txt" <<'PY'
import sys


def rows(path):
    parsed = {}
    with open(path, encoding="utf-8") as handle:
        for line in handle:
            name, alloc_count, alloc_bytes, peak_count, peak_bytes = line.split()
            parsed[name] = tuple(map(int, (alloc_count, alloc_bytes, peak_count, peak_bytes)))
    return parsed


first = rows(sys.argv[1])
second = rows(sys.argv[2])
if first.keys() != second.keys():
    raise SystemExit("benchmark rows changed")
for name in first:
    first_alloc_count, first_alloc_bytes, first_peak_count, first_peak_bytes = first[name]
    second_alloc_count, second_alloc_bytes, second_peak_count, second_peak_bytes = second[name]
    if (first_alloc_count, first_alloc_bytes) != (second_alloc_count, second_alloc_bytes):
        raise SystemExit(f"allocation traffic changed between Phase 2 runs for {name}")
    print(
        name,
        first_alloc_count,
        first_alloc_bytes,
        max(first_peak_count, second_peak_count),
        max(first_peak_bytes, second_peak_bytes),
    )
PY
cmp "$phase1/bench-fast-mediated-memory.txt" "$out/bench-fast-mediated-memory.txt"

if rg -n 'blocker_events' src/runtime/eval/indexed.rs > "$out/blocker-counter-usage.txt"; then
  echo "indexed IR safety must not depend on blocker_events" >&2
  exit 1
fi
rg -n 'indexed::|mod indexed' src --glob '*.rs' > "$out/production-routing.txt"
wc -l src/runtime/eval/indexed.rs src/runtime/eval/lower.rs > "$out/line-counts.txt"
{
  date -u '+date_utc=%Y-%m-%dT%H:%M:%SZ'
  uname -a
  rustc -vV
} > "$out/host.txt"

printf 'phase 2 evidence written to %s\n' "$out"
