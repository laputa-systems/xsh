#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
out=${1:-"$root/target/frontend-campaign/phase-3"}
phase0="$root/target/frontend-campaign/phase-0"
phase2="$root/target/frontend-campaign/phase-2"
mkdir -p "$out"
cd "$root"

cat > "$out/PROTOCOL.md" <<'EOF'
# Frontend Campaign Phase 3 Protocol

Hypothesis: Replacing indexed-IR value tags and owned record-contract type
payloads with canonical `TypeId`, `SignatureId`, and `ShapeId` references will
reduce the retained semantic representation by at least 20% on the checked-in
corpus without widening the approved instruction rows or changing production
allocation and peak-live behavior.

The Phase 1 row/store format and Phase 2 graph/SCC transaction design are
frozen. Semantic identities are one-based checked `u32` newtypes. Types use
parallel one-byte tag/eight-byte data columns and shared `u32` extra storage.
Signatures use eight-byte range rows and shared `u32` extra storage. Shapes use
eight-byte ranges over ordered `Name` identities. Canonical maps exist only in
construction state and are dropped before execution.

Recovery `Unknown` and `Invalid` types are rejected by interning and never
become executable facts. Semantic record and module types use the same
canonical ordered `ShapeId`; Phase 7 reuses this identity when runtime records
move away from maps.

The design is rejected if any semantic ID cannot remain four bytes, if semantic
facts require owned recursive trees in the finalized store, if common
instruction storage changes from 13 bytes, or if function/parameter/capture
rows exceed their 40/16/12-byte campaign budgets. Capture mutability occupies a
reserved flag bit in the `u32` slot word and does not widen the row.

The corpus comparison interns the stable facts currently retained by compact
declarations and body type maps, drops canonical maps, shrinks final columns,
and compares all finalized pool bytes with the recursive owned `Type` trees
they replace. Production frontend stats and coverage must remain unchanged.
Two `make bench-fast` runs are mediated by taking each row's maximum peak count
and bytes; the mediated memory table must match Phase 2 exactly.
EOF

rg -n \
  'Type::clone|ty\.clone|return_ty\.clone|sig\.clone|fields\.clone|exports\.clone|CallableType|ModuleExportType|BTreeMap<.*Type' \
  src/sema src/runtime crates/xsh-registry/src > "$out/semantic-inventory.txt"

cargo test -p xsh --lib runtime::eval::indexed:: \
  -- --test-threads=1 > "$out/tests.txt" 2>&1
cargo test --test integration sema:: \
  -- --test-threads=1 > "$out/sema-tests.txt" 2>&1
cargo test --test integration runtime::modules:: \
  -- --test-threads=1 > "$out/module-tests.txt" 2>&1
cargo test -p xsh --lib \
  runtime::eval::indexed::semantic::tests::equal_types_signatures_and_shapes_share_compact_ids \
  -- --nocapture --test-threads=1 > "$out/canonical-identities.txt" 2>&1
cargo test -p xsh --lib \
  runtime::eval::indexed::tests::corpus_semantic_pool_evidence \
  -- --ignored --nocapture --test-threads=1 > "$out/corpus-semantic.txt" 2>&1
cargo test -p xsh --lib \
  runtime::eval::indexed::tests::failed_mutual_recursion_scc_leaves_checkpoint_uncommitted \
  -- --test-threads=1 > "$out/scc-rollback.txt" 2>&1

rg -o 'phase3 semantic .*' "$out/corpus-semantic.txt" > "$out/corpus-semantic-summary.txt"
scripts/ir-layout.py > "$out/ir-layout.txt"

cargo build -p xsh --bin xsh --bin xsh-frontend-stats
target/debug/xsh-frontend-stats --json \
  tests/fixtures/frontend-campaign/vertical-slice.xsh \
  tests/fixtures/frontend-campaign/vertical-slice-unsupported.xsh \
  > "$out/frontend-stats-vertical-slice.json"
cmp "$phase0/frontend-stats-vertical-slice.json" \
  "$out/frontend-stats-vertical-slice.json"

target/debug/xsh tools/xsh-ir-coverage.xsh -- \
  --root . --json "$out/coverage.json" > "$out/coverage.txt"
cmp "$phase0/coverage.json" "$out/coverage.json"

baseline=$(scripts/bench-baseline.py --fast --print-path)
make bench-fast > "$out/bench-fast-1.txt" 2>&1
cp "$baseline" "$out/bench-fast-1.tsv"
make bench-fast > "$out/bench-fast-2.txt" 2>&1
cp "$baseline" "$out/bench-fast-2.tsv"
awk '!/^#/ {print $1, $3, $4, $5, $6}' "$out/bench-fast-1.tsv" \
  > "$out/bench-fast-1-memory.txt"
awk '!/^#/ {print $1, $3, $4, $5, $6}' "$out/bench-fast-2.tsv" \
  > "$out/bench-fast-2-memory.txt"

python3 - "$out/bench-fast-1-memory.txt" "$out/bench-fast-2-memory.txt" \
  > "$out/bench-fast-mediated-memory.txt" <<'PY'
import sys


def rows(path):
    parsed = {}
    with open(path, encoding="utf-8") as handle:
        for line in handle:
            name, alloc_count, alloc_bytes, peak_count, peak_bytes = line.split()
            parsed[name] = tuple(map(int, (alloc_count, alloc_bytes, peak_count, peak_bytes)))
    return parsed


first = rows(sys.argv[1])
second = rows(sys.argv[2])
if first.keys() != second.keys():
    raise SystemExit("benchmark rows changed")
for name in first:
    first_alloc_count, first_alloc_bytes, first_peak_count, first_peak_bytes = first[name]
    second_alloc_count, second_alloc_bytes, second_peak_count, second_peak_bytes = second[name]
    if (first_alloc_count, first_alloc_bytes) != (second_alloc_count, second_alloc_bytes):
        raise SystemExit(f"allocation traffic changed between Phase 3 runs for {name}")
    print(
        name,
        first_alloc_count,
        first_alloc_bytes,
        max(first_peak_count, second_peak_count),
        max(first_peak_bytes, second_peak_bytes),
    )
PY
cmp "$phase2/bench-fast-mediated-memory.txt" "$out/bench-fast-mediated-memory.txt"

rg -n \
  'TypeId|SignatureId|ShapeId|SemanticPools|type_id|signature' \
  src/runtime/eval/indexed.rs src/runtime/eval/indexed/semantic.rs \
  > "$out/semantic-id-ownership.txt"
wc -l \
  src/runtime/eval/indexed.rs \
  src/runtime/eval/indexed/semantic.rs \
  src/runtime/eval/lower.rs > "$out/line-counts.txt"
{
  date -u '+date_utc=%Y-%m-%dT%H:%M:%SZ'
  uname -a
  rustc -vV
} > "$out/host.txt"

printf 'phase 3 evidence written to %s\n' "$out"
