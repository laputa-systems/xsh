{
  "date": "2026-09-25",
  "purpose": "Reuse decoded indexed call-argument descriptor vectors across completed calls",
  "workload": "100,000 increments per script; inline loop control or one-argument proc/pure call each iteration; exact value=100000 output",
  "scripts": {
    "inline": {
      "source": "proc main(...argv: List[Str]) [io, error] {\n  let count = argv[0].parse_int()?\n  var value = 0\n  while value < count {\n    value = value + 1\n  }\n  print f\"value=${value}\"\n}\n",
      "sha256": "62709fe6066b4dc1323b474d138dd5ea6460a950d5fb9d391587990cf8b8f37f"
    },
    "proc": {
      "source": "proc increment(value: Int) [] -> Int { return value + 1 }\nproc main(...argv: List[Str]) [io, error] {\n  let count = argv[0].parse_int()?\n  var value = 0\n  while value < count {\n    value = increment(value)\n  }\n  print f\"value=${value}\"\n}\n",
      "sha256": "f5997d11745301bc032a05e0836087be5f40fbaee3c549ebbe64ccc4e01d1f0c"
    },
    "pure": {
      "source": "pure increment(value: Int) -> Int { return value + 1 }\nproc main(...argv: List[Str]) [io, error] {\n  let count = argv[0].parse_int()?\n  var value = 0\n  while value < count {\n    value = increment(value)\n  }\n  print f\"value=${value}\"\n}\n",
      "sha256": "9d4b887ad53734bca60d9bcae157b7a5f57ba4986fd8bd1f34e14c00fad577cc"
    }
  },
