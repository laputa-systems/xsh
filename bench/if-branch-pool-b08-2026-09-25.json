    "control": {
      "source": "proc main(...argv: List[Str]) [io, error] {\n  let count = argv[0].parse_int()?\n  var value = 0\n  while value < count {\n    value = value + 1\n  }\n  print f\"value=${value}\"\n}\n",
      "sha256": "62709fe6066b4dc1323b474d138dd5ea6460a950d5fb9d391587990cf8b8f37f"
    },
    "stmt_if": {
      "source": "proc main(...argv: List[Str]) [io, error] {\n  let count = argv[0].parse_int()?\n  var value = 0\n  while value < count {\n    if value % 2 == 0 { value = value + 1 } else { value = value + 1 }\n  }\n  print f\"value=${value}\"\n}\n",
      "sha256": "95289059fdd6f1becb1634bafaa7cfb63b2b72c45ff01721cb9cd9426d9641ae"
    },
    "expr_if": {
      "source": "proc main(...argv: List[Str]) [io, error] {\n  let count = argv[0].parse_int()?\n  var value = 0\n  while value < count {\n    value = if value % 2 == 0 { value + 1 } else { value + 1 }\n  }\n  print f\"value=${value}\"\n}\n",
      "sha256": "c46720e9c5f573dbede87cda96fe678ba756dd9973f2a4fd74479e15163ace5f"
    }
  },
