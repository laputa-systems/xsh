FROM alpine:edge
ARG TARGETARCH
RUN apk add --no-cache bash make perl autoconf automake libtool gettext quilt gperf texinfo gawk help2man rsync \
    acl-dev libcap-dev openssl-dev \
    musl-dev linux-headers libgcc libunwind-dev git binutils tzdata zip strace \
    clang23 clang23-libclang \
    findmnt lsblk lscpu util-linux util-linux-misc iproute2-minimal kmod pciutils usbutils cpupower \
    lm-sensors dmidecode
# GNU test helpers link against the unversioned GCC runtime name.
RUN ln -sf /usr/lib/libgcc_s.so.1 /usr/lib/libgcc_s.so
RUN for tool in /bin/findmnt /bin/lsblk /usr/bin/lscpu /sbin/swapon /sbin/ip \
        /sbin/lsmod /usr/bin/lspci /usr/bin/lsusb /usr/bin/cpupower \
        /usr/bin/sensors /usr/sbin/dmidecode; do \
        test -x "$tool" || exit 1; \
    done
ADD https://static.rust-lang.org/rustup/dist/x86_64-unknown-linux-musl/rustup-init /rustup-init-x86_64
ADD https://static.rust-lang.org/rustup/dist/aarch64-unknown-linux-musl/rustup-init /rustup-init-aarch64
RUN case "$TARGETARCH" in \
        amd64) init=/rustup-init-x86_64 ;; \
        arm64) init=/rustup-init-aarch64 ;; \
    esac \
    && cp "$init" /rustup-init \
    && chmod +x /rustup-init \
    && /rustup-init -y --default-toolchain none \
    && rm /rustup-init /rustup-init-x86_64 /rustup-init-aarch64
ENV PATH="/usr/local/bin:/root/.cargo/bin:$PATH"
RUN rustup toolchain install nightly-2026-09-15 \
    --target aarch64-unknown-linux-musl \
    --target x86_64-unknown-linux-musl \
    --component llvm-tools-preview \
    --component rust-src
# Clang and libclang are separate Alpine packages. The Rust nightly supplies
# LLVM archive, strip, and linker tools, but not a C frontend. Copy those tools
# out of root's rustup tree so unprivileged compatibility tests can execute them.
RUN case "$TARGETARCH" in \
        amd64) host=x86_64-unknown-linux-musl ;; \
        arm64) host=aarch64-unknown-linux-musl ;; \
        *) exit 1 ;; \
    esac \
    && tool_bin="$(rustc --print sysroot)/lib/rustlib/$host/bin" \
    && for tool in llvm-ar llvm-strip rust-lld; do \
        test -x "$tool_bin/$tool" && install -m 0755 "$tool_bin/$tool" "/usr/local/bin/$tool"; \
    done \
    && test -f /usr/lib/llvm23/lib/libclang.so
# musl-dev lacks crtbegin/crtend. The empty target-correct objects satisfy
# Clang's C-linker inputs without bringing in GCC's runtime.
RUN for target in aarch64-unknown-linux-musl x86_64-unknown-linux-musl; do \
        stub_dir="/usr/lib/xsh-crt/$target"; \
        mkdir -p "$stub_dir"; \
        for obj in crtbegin.o crtbeginS.o crtbeginT.o crtend.o crtendS.o; do \
            clang-23 --target="$target" -x c -c /dev/null -o "$stub_dir/$obj"; \
        done; \
    done
# rust-lld may not support the debug-section compression used in Alpine's CRT.
RUN for object in /usr/lib/crt*.o /usr/lib/[S]*.o; do \
        test -f "$object" || continue; \
        llvm-strip --strip-debug "$object"; \
    done
ENV CC="/usr/bin/clang-23" \
    AR="/usr/local/bin/llvm-ar" \
    RANLIB="/usr/bin/ranlib" \
    LIBCLANG_PATH="/usr/lib/llvm23/lib" \
    CC_AARCH64_UNKNOWN_LINUX_MUSL="/usr/bin/clang-23" \
    CC_X86_64_UNKNOWN_LINUX_MUSL="/usr/bin/clang-23" \
    CARGO_TARGET_AARCH64_UNKNOWN_LINUX_MUSL_LINKER="rust-lld" \
    CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_LINKER="rust-lld" \
    CFLAGS_aarch64_unknown_linux_musl="--target=aarch64-unknown-linux-musl -B/usr/lib/xsh-crt/aarch64-unknown-linux-musl -I/usr/include" \
    CFLAGS_x86_64_unknown_linux_musl="--target=x86_64-unknown-linux-musl -B/usr/lib/xsh-crt/x86_64-unknown-linux-musl -I/usr/include"
# The build driver supplies the musl target Rust flags, including the
# __isoc23_sscanf=sscanf and __isoc23_strtol=strtol aliases. Keep those flags
# outside the image so local tests and the Linux package job use one link ABI.
# Some container hosts expose only partial loop-device behavior. Run real
# loop and mount coverage with the dedicated privileged Linux test target.
# Host proc-macro crates link dynamically while Cargo is building. The musl
# rustup sysroot does not always expose the Alpine libc and libgcc_s names that
# rust-lld searches for, so install stable symlinks in the host target libdir.
RUN host_libdir="$(rustc --print target-libdir)" \
    && ln -sf /usr/lib/libgcc_s.so.1 "${host_libdir}/libgcc_s.so" \
    && ln -sf /usr/lib/libgcc_s.so.1 "${host_libdir}/libgcc_s.so.1" \
    && ln -sf /usr/lib/libc.so "${host_libdir}/libc.so"
# The PTY test harness (`laputa-ptytest`) links `-lutil` on Linux. musl keeps
# `openpty` in libc and Rust's musl sysroots ship no libutil, so give each target
# an empty archive, as Alpine's musl-dev does for its own libc.
RUN for target in aarch64-unknown-linux-musl x86_64-unknown-linux-musl; do \
        llvm-ar rc "$(rustc --print target-libdir --target "$target")/libutil.a"; \
    done
RUN apk add --no-cache python3 \
    && addgroup -g 1000 compat \
    && adduser -D -u 1000 -G compat -h /home/compat compat
