FROM alpine:3.24.1
ARG TARGETARCH
ARG LLVM_VERSION=23.1.0-rc2
ARG LLVM_RELEASE_SHA=6eb5fb9
# aws-lc-sys probes <linux/random.h> and links its C feature checks against
# libunwind while building the musl targets.
RUN apk add --no-cache musl-dev linux-headers libgcc libunwind-dev git make binutils tzdata zip strace
# Keep Dockerfile.test on the same compiler family as release.yml. The release
# workflow restores this tarball from the GitHub cache or downloads the same URL,
# then points CC/target flags at its clang.
ADD https://github.com/laputa-systems/llvm-prebuilt-musl/releases/download/llvm-musl-${LLVM_VERSION}-${LLVM_RELEASE_SHA}/clang+llvm-${LLVM_VERSION}-x86_64-linux-musl.tar.xz /tmp/llvm-x86_64.tar.xz
ADD https://github.com/laputa-systems/llvm-prebuilt-musl/releases/download/llvm-musl-${LLVM_VERSION}-${LLVM_RELEASE_SHA}/clang+llvm-${LLVM_VERSION}-aarch64-linux-musl.tar.xz /tmp/llvm-aarch64.tar.xz
RUN case "$TARGETARCH" in \
        amd64) f=/tmp/llvm-x86_64.tar.xz ;; \
        arm64) f=/tmp/llvm-aarch64.tar.xz ;; \
    esac \
    && echo '36647cca0bf57d206a6ce757d07a9d8489ef6ccf283a2cc7f740d1cba99a088b  /tmp/llvm-x86_64.tar.xz' | sha256sum -c - \
    && echo '0c9bd6f0fefa26dbdb7d6ed568f3799b558428b1ce1264656aa328fc6fd9e32d  /tmp/llvm-aarch64.tar.xz' | sha256sum -c - \
    && mkdir -p /opt/llvm-musl \
    && tar xf "$f" -C /opt/llvm-musl --strip-components=1 \
    && test -f /opt/llvm-musl/lib/libclang.so \
    && rm /tmp/llvm-x86_64.tar.xz /tmp/llvm-aarch64.tar.xz
ENV PATH="/opt/llvm-musl/bin:$PATH"
# The prebuilt LLVM tree does not ship GNU crtbegin/crtend objects. aws-lc-sys
# links temporary C probe executables, so provide empty target-correct stubs
# instead of installing GCC just for those linker inputs.
RUN for target in aarch64-unknown-linux-musl x86_64-unknown-linux-musl; do \
        stub_dir="/usr/lib/xsh-crt/$target"; \
        mkdir -p "$stub_dir"; \
        for obj in crtbegin.o crtbeginS.o crtbeginT.o crtend.o crtendS.o; do \
            clang --target="$target" -x c -c /dev/null -o "$stub_dir/$obj"; \
        done; \
    done
# The prebuilt LLVM's rust-lld is not linked against zlib, so it cannot read
# Alpine's zlib-compressed debug sections in musl crt object files.
RUN llvm-strip --strip-debug /usr/lib/crt*.o /usr/lib/[S]*.o 2>/dev/null || true
ADD https://static.rust-lang.org/rustup/dist/x86_64-unknown-linux-musl/rustup-init /rustup-init-x86_64
ADD https://static.rust-lang.org/rustup/dist/aarch64-unknown-linux-musl/rustup-init /rustup-init-aarch64
RUN case "$TARGETARCH" in \
        amd64) init=/rustup-init-x86_64 ;; \
        arm64) init=/rustup-init-aarch64 ;; \
    esac \
    && cp "$init" /rustup-init \
    && chmod +x /rustup-init \
    && /rustup-init -y --default-toolchain none \
    && rm /rustup-init /rustup-init-x86_64 /rustup-init-aarch64
# These mirror the Linux package job's compiler environment. The include path is
# Alpine's musl-dev headers live under /usr/include, unlike Debian-style
# /usr/include/${arch}-linux-musl directories.
ENV PATH="/opt/llvm-musl/bin:/root/.cargo/bin:$PATH" \
    CC="/opt/llvm-musl/bin/clang" \
    AR="/opt/llvm-musl/bin/llvm-ar" \
    RANLIB="/opt/llvm-musl/bin/llvm-ranlib" \
    LIBCLANG_PATH="/opt/llvm-musl/lib" \
    CC_AARCH64_UNKNOWN_LINUX_MUSL="/opt/llvm-musl/bin/clang" \
    CC_X86_64_UNKNOWN_LINUX_MUSL="/opt/llvm-musl/bin/clang" \
    CARGO_TARGET_AARCH64_UNKNOWN_LINUX_MUSL_LINKER="rust-lld" \
    CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_LINKER="rust-lld" \
    CFLAGS_aarch64_unknown_linux_musl="--target=aarch64-unknown-linux-musl -B/usr/lib/xsh-crt/aarch64-unknown-linux-musl -I/usr/include" \
    CFLAGS_x86_64_unknown_linux_musl="--target=x86_64-unknown-linux-musl -B/usr/lib/xsh-crt/x86_64-unknown-linux-musl -I/usr/include" \
    AWS_LC_SYS_CFLAGS_aarch64_unknown_linux_musl="--target=aarch64-unknown-linux-musl -B/usr/lib/xsh-crt/aarch64-unknown-linux-musl -I/usr/include" \
    AWS_LC_SYS_CFLAGS_x86_64_unknown_linux_musl="--target=x86_64-unknown-linux-musl -B/usr/lib/xsh-crt/x86_64-unknown-linux-musl -I/usr/include" \
    AWS_LC_SYS_NO_JITTER_ENTROPY="1"
# The dist Makefile owns the musl target Rust flags, including the
# __isoc23_sscanf=sscanf and __isoc23_strtol=strtol aliases. Those aliases keep
# newer C objects linkable against the older musl symbols available in rustc's
# self-contained musl target while still letting dist builds use build-std and
# fat LTO. Keep Dockerfile.test focused on providing the CI-like toolchain; do
# not duplicate those target Rust flags here or local repros can drift from
# `make dist`.
# Some CI/container hosts expose only partial loop-device behavior. An
# unprivileged container may allow `mknod /dev/loop0 b 7 0` but still reject real
# loop setup without SYS_ADMIN or a usable /dev/loop-control. Use the dedicated
# privileged Makefile targets for real loop/mount coverage, and use an
# unprivileged run only to reproduce graceful handling of read-only or denied
# loop-device surfaces.
RUN rustup toolchain install nightly-2026-07-24 \
    --target aarch64-unknown-linux-musl \
    --target x86_64-unknown-linux-musl \
    --component llvm-tools-preview
# Host proc-macro crates link dynamically while Cargo is building. The musl
# rustup sysroot does not always expose the Alpine libc and libgcc_s names that
# rust-lld searches for, so install stable symlinks in the host target libdir.
RUN host_libdir="$(rustc --print target-libdir)" \
    && ln -sf /usr/lib/libgcc_s.so.1 "${host_libdir}/libgcc_s.so" \
    && ln -sf /usr/lib/libgcc_s.so.1 "${host_libdir}/libgcc_s.so.1" \
    && ln -sf /usr/lib/libc.so "${host_libdir}/libc.so"
