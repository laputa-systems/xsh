{
  "date": "2026-06-10",
  "binary": "target/debug/xsh",
  "command": "hyperfine --warmup 3 --export-json target/perf/interpreter-hyperfine-unit-break-ir-full.json '<binary> <scenario> >/dev/null'",
  "notes": [
    "Debug-profile end-to-end CLI timings.",
    "Times are hyperfine mean wall times from this session on the local machine.",
    "post_trace_cleanup starts after tracing became opt-in and method trace names were skipped when tracing is disabled.",
    "lowered_int_pure lowers simple pure Int functions with integer expressions, if-return guards, and self-recursive calls.",
    "expanded_lowered_int_pure reran the full set after adding pure-loop, pure-call-chain, pure-result, stream-callback, and record-glue scenarios.",
    "lowered_stmt_bool adds local slots, while loops, direct lowered pure calls, self-call lowering, and Bool-return pure lowering.",
    "lowered_result adds Result[Int] lowering for Ok, Err(Error), and ? propagation.",
    "self_update_fast_paths updates list.push and map.set assignment forms in place when the receiver is the assigned binding and the RHS is safe.",
    "wide_scalar_ir changes lowered slots to typed scalar values and adds Str params, literals, interpolation, returns, and selected Str methods.",
    "record_ir adds Record parameters, record literals, field access, and record get/has methods to lowered IR.",
    "collection_ir adds List and Map parameters/returns, list literals, index expressions, and common list/map methods to lowered IR.",
    "borrowed_collection_access keeps lowered records/lists/maps in lowered form and avoids cloning whole slot receivers for read-only index/get/len/has/contains operations.",
    "logical_if_expr_ir lowers short-circuit Bool and/or plus expression-if in pure functions; text-glue now exercises those forms, so compare that scenario to this phase and later.",
    "text_method_ir lowers Str.split, Str.replace, Str.parse_int, and List.join; text-glue now also exercises those methods, so compare that scenario to this phase and later.",
    "lowered_for_ir lowers for-over-list loops in pure functions; text-glue now also exercises lowered for, so compare that scenario to this phase and later.",
    "membership_ir lowers string/list membership with in and not in; text-glue now uses membership instead of equivalent contains calls, so compare that scenario to this phase and later.",
    "stmt_if_else_ir lowers statement if/else and else-if branches in pure functions; text-glue now uses statement if/else assignment, so compare that scenario to this phase and later.",
    "scalar_match_ir lowers scalar literal and wildcard match arms in pure functions; text-glue now uses scalar match in both expression and statement forms, so compare that scenario to this phase and later.",
    "path_ir lowers Path parameters, returns, formatting, equality, and display/name/ext/parent methods; adds path-ir-glue-5k as a path-heavy pure helper scenario.",
    "nominal_record_ir lowers user-defined and standard record schema types as structural Record in pure-function IR; adds nominal-record-ir-glue-5k with named record params/returns inside lowered calls.",
    "result_fallback_ir lowers Result `??` fallback in pure-function IR; adds result-fallback-ir-glue-5k for parse_int-or-default workloads seen in core scripts.",
    "error_helper_ir lowers plain Error values, structured error constructors, Error.kind/message field access, and Err(error_helper(...)) in pure-function IR; adds error-helper-ir-glue-5k for applet-style usage helpers.",
    "pipeline_slice_ir lowers simple list take/drop structured pipelines in pure-function IR; adds pipeline-slice-ir-glue-5k for string/list slicing patterns found in core and package scripts.",
    "collection_helpers_ir lowers List.extend plus Record.keys and Map.keys in pure-function IR; adds collection-helpers-ir-glue-5k for collection assembly and key iteration patterns from package scripts.",
    "continue_ir lowers bare continue statements in pure-function for/while bodies; coverage now treats desugared continue-when/unless loops as lowerable when the surrounding expressions are supported.",
    "result_context_lower_ir adds lowered Result.context, Str.lower, continue, take/drop list pipelines, extend/keys collection helpers, and scans xsh + ../packages + ../laputa for IR coverage.",
    "pipeline_filter_map_ir adds lowered list-pipeline where/map item support, tracks LoweredPipelineStage counts, and adds the pipeline-filter-map-ir-glue-5k scenario.",
    "enumerate_list_comp_ir adds lowered list comprehensions and enumerate() list-pipeline support, with the enumerate-list-comp-ir-glue-5k scenario.",
    "path_normalize_relative_ir lowers Path.normalize and Path.relative_to, refreshes path-ir-glue-5k to exercise normalized and relative path glue, and aligns IR coverage with standard record schemas from sema/records.rs.",
    "regex_ir lowers Regex values, regex.compile, and Regex.matches/captures/replace for pure-function IR; adds regex-ir-glue-5k for package-style regex wrapper workloads.",
    "status_ir lowers Status values, scalar Status fields, and Status exited/signaled/exit_code/signal_number methods for pure-function IR; adds status-ir-glue-5k for status-classification helpers.",
    "qualified_pure_ir lowers qualified pure helper calls inside lowered pure bodies after module imports refresh the lowered registry; adds qualified-pure-ir-glue-5k for imported helper workloads.",
    "pipeline_sort_ir lowers list-pipeline sort and sort-by stages in pure-function IR; adds pipeline-sort-ir-glue-5k for typed record sort-by and string sort workloads.",
    "unit_break_ir lowers Unit/Result[Unit] returns and bare break statements in pure-function loops; no new scenario was added because existing loop/result scenarios cover the dispatch surface.",
    "script_top_level_ir_inference records the focused script-ir-top-level-glue-10k scenario after adding inferred top-level script slots and script-level coverage reporting; this phase did not refresh the full suite.",
    "effect_free_proc_script_ir records a focused mixed-proc-ir-glue-2k scenario after adding restricted [error]/[] proc bodies callable from script-level IR; this phase did not refresh the full suite.",
    "text_lines_pipeline_ir records a focused text-lines-pipeline-ir-glue-5k scenario after adding List/Map pure returns, the lowered text.lines adapter stage, and simple one-parameter map block lowering; this phase did not refresh the full suite.",
    "group_by_pipeline_ir records a focused group-by-pipeline-ir-glue-5k scenario after adding lowered group-by bucket records for list pipelines; this phase did not refresh the full suite.",
    "tag_union_ir records a focused tag-union-ir-glue-5k scenario after adding lowered tag-union types, constructors, simple constructor patterns, pure tail expressions, and expression-only pure tail match statements; this phase did not refresh the full suite.",
    "reverse_values_ir records a focused collection-helpers-ir-glue-5k scenario after adding lowered Str.reverse and Map.values methods and refreshing that scenario to exercise both; this phase did not refresh the full suite.",
    "count_lines_int_ir records a focused count-lines-ir-glue-20k scenario after adding a direct typed-int node for slot-backed Str.count_lines(); this phase did not refresh the full suite."
  ],
